{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessl3.local/spec/v1/response.schema.json",
  "title": "HarnessL3 CLI v1 JSON response envelope",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "target", "replayed", "ok"],
  "properties": {
    "schemaVersion": { "const": 1 }, "requestId": { "$ref": "common.schema.json#/$defs/uuid" },
    "target": { "oneOf": [{ "$ref": "common.schema.json#/$defs/target" }, { "type": "null" }] },
    "replayed": { "type": "boolean" }, "ok": { "type": "boolean" }, "data": { "$ref": "#/$defs/data" }, "error": { "$ref": "#/$defs/error" }
  },
  "oneOf": [
    { "properties": { "ok": { "const": true } }, "required": ["data"], "not": { "required": ["error"] } },
    { "properties": { "ok": { "const": false } }, "required": ["error"], "not": { "required": ["data"] } }
  ],
  "$defs": {
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }, "details": { "type": "object" }
      }
    },
    "skillPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "batchId", "routerVersion", "catalogRevision", "skills", "observation"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" }, "batchId": { "$ref": "common.schema.json#/$defs/uuid" },
        "routerVersion": { "type": "string", "minLength": 1 }, "catalogRevision": { "$ref": "common.schema.json#/$defs/sha256" },
        "skills": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "group", "description", "reason", "contentHash", "files"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/skillId" }, "name": { "type": "string", "minLength": 1 },
              "group": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 },
              "contentHash": { "$ref": "common.schema.json#/$defs/sha256" }, "files": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/fileRef" } }
            }
          }
        },
        "observation": { "const": "selection-recorded; execution-unknown" }
      }
    },
    "packet": {
      "type": "object", "additionalProperties": false, "required": ["scope", "contexts", "evidence"],
      "properties": {
        "scope": { "const": "returned-entities-only" },
        "contexts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/contextBody" } },
        "evidence": { "type": "array", "items": { "$ref": "evidence.schema.json#/$defs/evidence" } }
      }
    },
    "taskEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "status", "taskId", "binding", "routerVersion", "routingPrompt", "directory", "catalog", "observation"],
      "properties": {
        "kind": { "const": "task-entry" }, "status": { "const": "complete" }, "taskId": { "$ref": "common.schema.json#/$defs/uuid" },
        "binding": { "$ref": "common.schema.json#/$defs/binding" }, "routerVersion": { "type": "string", "minLength": 1 },
        "routingPrompt": { "type": "string", "minLength": 1 }, "directory": { "$ref": "common.schema.json#/$defs/directory" },
        "catalog": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/skillBrief" } },
        "observation": { "const": "routing-material-produced; selection-not-recorded" }
      }
    },
    "contextBatch": {
      "type": "object", "additionalProperties": false, "required": ["kind", "status", "taskId", "binding", "result"],
      "properties": {
        "kind": { "const": "context-batch" }, "status": { "enum": ["complete", "partial"] },
        "taskId": { "$ref": "common.schema.json#/$defs/uuid" }, "binding": { "$ref": "common.schema.json#/$defs/binding" },
        "result": { "$ref": "common.schema.json#/$defs/batchResult" }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["kind", "status", "taskId", "binding", "result", "skillPlan", "packet"],
      "properties": {
        "kind": { "const": "selection" }, "status": { "enum": ["complete", "partial"] }, "taskId": { "$ref": "common.schema.json#/$defs/uuid" },
        "binding": { "$ref": "common.schema.json#/$defs/binding" }, "result": { "$ref": "common.schema.json#/$defs/batchResult" },
        "skillPlan": { "$ref": "#/$defs/skillPlan" }, "packet": { "$ref": "#/$defs/packet" }
      }
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "status", "taskId", "binding", "throughBatchId", "completeness", "packet", "skillPlan", "observation"],
      "properties": {
        "kind": { "const": "handoff" }, "status": { "const": "complete" }, "taskId": { "$ref": "common.schema.json#/$defs/uuid" },
        "binding": { "$ref": "common.schema.json#/$defs/binding" },
        "throughBatchId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
        "completeness": { "enum": ["complete", "partial", "unknown"] }, "packet": { "$ref": "#/$defs/packet" },
        "skillPlan": { "oneOf": [{ "$ref": "#/$defs/skillPlan" }, { "type": "null" }] },
        "observation": { "const": "archived-resources; understanding-and-execution-unknown" }
      }
    },
    "skillFiles": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "status", "taskId", "throughBatchId", "files", "errors", "observation"],
      "properties": {
        "kind": { "const": "skill-files" }, "status": { "enum": ["complete", "partial"] }, "taskId": { "$ref": "common.schema.json#/$defs/uuid" },
        "throughBatchId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
        "files": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["skillId", "file"],
            "properties": {
              "skillId": { "$ref": "common.schema.json#/$defs/skillId" },
              "file": {
                "type": "object", "additionalProperties": false, "required": ["path", "hash", "bytes", "encoding", "content"],
                "properties": {
                  "path": { "$ref": "common.schema.json#/$defs/relativePath" }, "hash": { "$ref": "common.schema.json#/$defs/sha256" },
                  "bytes": { "type": "integer", "minimum": 0 }, "encoding": { "enum": ["utf8", "base64"] }, "content": { "type": "string" }
                }
              }
            }
          }
        },
        "errors": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/itemError" } },
        "observation": { "const": "archived-files-returned; execution-unknown" }
      }
    },
    "commandResult": {
      "type": "object", "additionalProperties": false, "required": ["kind", "status", "operation", "result"],
      "properties": {
        "kind": { "const": "command-result" }, "status": { "const": "complete" },
        "operation": { "type": "string", "minLength": 1 }, "result": { "type": "object" }
      }
    },
    "legacyArchive": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "status", "format", "taskId", "binding", "throughBatchId", "completeness", "record"],
      "properties": {
        "kind": { "const": "legacy-archive" }, "status": { "const": "complete" }, "format": { "const": "prototype-v0.16" },
        "taskId": { "$ref": "common.schema.json#/$defs/uuid" },
        "binding": {
          "type": "object", "additionalProperties": false,
          "required": ["projectId", "worktreeId", "modelRevision", "catalogRevision", "sourceVersion", "sourceScanRevision"],
          "properties": {
            "projectId": { "$ref": "common.schema.json#/$defs/uuid" }, "worktreeId": { "$ref": "common.schema.json#/$defs/uuid" },
            "modelRevision": { "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }] },
            "catalogRevision": { "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }] },
            "sourceVersion": { "oneOf": [{ "$ref": "common.schema.json#/$defs/sourceVersion" }, { "type": "null" }] },
            "sourceScanRevision": { "type": "null" }
          }
        },
        "throughBatchId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
        "completeness": { "enum": ["complete", "partial", "unknown"] }, "record": { "type": "object" }
      }
    },
    "data": { "oneOf": [
      { "$ref": "#/$defs/taskEntry" }, { "$ref": "#/$defs/contextBatch" }, { "$ref": "#/$defs/selection" },
      { "$ref": "#/$defs/handoff" }, { "$ref": "#/$defs/skillFiles" }, { "$ref": "#/$defs/commandResult" }, { "$ref": "#/$defs/legacyArchive" }
    ] }
  }
}
