{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessl3.local/spec/v1/model-maintenance.schema.json",
  "title": "Current-agent model maintenance guidance result",
  "type": "object", "additionalProperties": false,
  "required": ["promptVersion", "mode", "stage", "semanticStatus", "worktreeRoot", "sourceScan", "modelState", "modelRevision", "files", "topology", "coverage", "diagnostics", "observedSource", "agentPrompt", "nextCommands"],
  "properties": {
    "promptVersion": { "const": "model-maintenance/1" },
    "mode": { "enum": ["supplement", "revise", "rebuild"] },
    "stage": { "const": "guidance-ready" }, "semanticStatus": { "const": "not-assessed" },
    "worktreeRoot": { "type": "string", "minLength": 1 }, "sourceScan": { "const": "not-requested" },
    "modelState": { "enum": ["valid", "invalid"] },
    "modelRevision": { "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "files": {
      "type": "object", "additionalProperties": false, "required": ["model", "evidence", "aliases"],
      "properties": { "model": { "const": ".harness/model/" }, "evidence": { "const": ".harness/evidence.json" }, "aliases": { "const": ".harness/aliases.json" } }
    },
    "topology": { "oneOf": [{ "type": "null" }, {
      "type": "object", "additionalProperties": false, "required": ["objects", "relations", "maxDepth", "views"],
      "properties": {
        "objects": { "type": "integer", "minimum": 0 }, "relations": { "type": "integer", "minimum": 0 }, "maxDepth": { "type": "integer", "minimum": 0 },
        "views": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "title", "nodes", "edges"],
          "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": ["string", "null"] }, "nodes": { "type": "integer", "minimum": 0 }, "edges": { "type": "integer", "minimum": 0 } }
        } }
      }
    }] },
    "coverage": { "oneOf": [{ "type": "null" }, {
      "type": "object", "additionalProperties": false, "required": ["scope", "unrepresentedLeaves", "hints"],
      "properties": {
        "scope": { "const": "model-views-only" },
        "unrepresentedLeaves": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "locator", "title"],
          "properties": { "id": { "$ref": "common.schema.json#/$defs/uuid" }, "locator": { "type": "string" }, "title": { "type": "string" } }
        } },
        "hints": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } }
        } }
      }
    }] },
    "diagnostics": { "type": "array", "items": { "type": "object" } },
    "observedSource": { "oneOf": [{ "type": "null" }, {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "sourceEpoch", "sourceVersion", "sourceScanRevision", "checkedAt", "pendingPaths"],
      "properties": {
        "scope": { "const": "last-observed" }, "state": { "enum": ["unknown", "pending", "verifying", "verified", "failed"] },
        "sourceEpoch": { "type": "integer", "minimum": 0 }, "sourceVersion": { "$ref": "common.schema.json#/$defs/sourceVersion" },
        "sourceScanRevision": { "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }] },
        "checkedAt": { "type": ["string", "null"], "format": "date-time" }, "pendingPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }] },
    "agentPrompt": { "type": "string", "minLength": 1 },
    "nextCommands": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
  },
  "allOf": [{
    "if": { "properties": { "modelState": { "const": "invalid" } } },
    "then": { "properties": { "topology": { "type": "null" }, "coverage": { "type": "null" } } },
    "else": { "properties": { "modelRevision": { "$ref": "common.schema.json#/$defs/sha256" }, "topology": { "type": "object" }, "coverage": { "type": "object" } } }
  }]
}
