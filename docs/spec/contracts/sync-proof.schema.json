{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessl3.local/spec/v1/sync-proof.schema.json",
  "title": "Stage verification declaration with source compare-and-swap",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "target", "phaseId", "sourceEpoch", "expectedSourceVersion", "expectedModelRevision", "scope", "disposition", "reason", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 }, "requestId": { "$ref": "common.schema.json#/$defs/uuid" }, "target": { "$ref": "common.schema.json#/$defs/target" },
    "phaseId": { "$ref": "common.schema.json#/$defs/uuid" }, "sourceEpoch": { "type": "integer", "minimum": 0 },
    "expectedSourceVersion": { "$ref": "common.schema.json#/$defs/sourceVersion" }, "expectedModelRevision": { "$ref": "common.schema.json#/$defs/sha256" },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["paths", "entities"],
      "properties": {
        "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
        "entities": { "$ref": "common.schema.json#/$defs/ids" }
      },
      "anyOf": [{ "properties": { "paths": { "minItems": 1 } } }, { "properties": { "entities": { "minItems": 1 } } }]
    },
    "disposition": { "enum": ["updated", "no-semantic-change", "unresolved"] }, "reason": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "status", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed", "unknown"] },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
