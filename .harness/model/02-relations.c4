model {
  app.cli -[uses]-> app.service "认证RPC与服务复用" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000001"
      brief "CLI直接认证RPC调用同一核心；仅未执行失败有界重连，保持requestId和单实例。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000002 d6250000-0000-4000-8000-000000000016"
      version "2"
    }
  }
  app.web -[uses]-> app.service "Web API与事件流" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000002"
      brief "Web确认同源浏览会话后访问RPC、view及worktree事件流，登录中断保留凭证供显式重试。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000003 d6250000-0000-4000-8000-000000000010"
      version "2"
    }
  }
  app.service -[uses]-> app.core.runtime "分派公共用例" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000003"
      brief "HTTP服务将已校验命令交给Runtime执行，视图来自同一Runtime。"
