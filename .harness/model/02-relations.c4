model {
  app.cli -[uses]-> app.service "认证RPC与服务复用" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000001"
      brief "CLI直接认证RPC调用同一核心；仅未执行失败有界重连，保持requestId和单实例。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000002 d6250000-0000-4000-8000-000000000016"
      version "2"
    }
  }
  app.web -[uses]-> app.service "Web API与事件流" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000002"
      brief "Web以24小时目标链接取得同源会话后访问RPC、view及事件流，中断时可用同一链接重试。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000003 d6250000-0000-4000-8000-000000000010"
      version "3"
    }
  }
  app.cli -[uses]-> app.service.webAccess "请求签发本机网页授权" {
    metadata {
      harness_id "2db81737-d50b-403d-a12c-940b271066ce"
      brief "CLI经认证服务请求按实际目标签发链接，并返回该链接的独立到期时间。"
      source "fact"
      status "verified"
      evidence "fa0b94b7-6a85-464d-980a-79b8a1ec8598 d6250000-0000-4000-8000-000000000003"
      version "1"
    }
  }
  app.service -[uses]-> app.core.runtime "分派公共用例" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000003"
      brief "HTTP按CLI完整用例或Web只读浏览分派；SSE只读取提交游标，不恢复同步历史。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000003"
      version "2"
    }
  }
  app.core.runtime -[uses]-> app.core.workspace "定位工作区" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000004"
      brief "Runtime通过WorkspaceRegistry核对实际目标和本机Git关联；项目入口归组，工作区与任务UUID隔离。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000004"
      version "3"
    }
  }
  app.core.runtime -[uses]-> app.core.context "任务与交接" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000005"
      brief "Runtime装配完整任务资源或不打开SQLite/不扫描源码的Web浏览TaskService。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000004"
      version "2"
    }
  }
  app.core.runtime -[uses]-> app.core.model "校验与投影" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000006"
      brief "Runtime在显式初始化/模型校验读取当前模型；普通视图复用已记录快照并保留当前解析或未知状态。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000004"
      version "3"
    }
  }
  app.core.runtime -[uses]-> app.core.skills "目录与刷新" {
    metadata {
      harness_id "e6250000-0000-4000-8000-000000000007"
      brief "Runtime按实际技能路径复用浏览目录观测，显式刷新重新扫描；严格任务捕获独立进行。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000004"
      version "2"
    }
  }
