specification {
  element system
  element component
  element artifact
  relationship uses
  relationship guides
  relationship verifies
}
model {
  app = system "HarnessL3" {
    description "面向现有agent的项目上下文CLI，以LikeC4文本为权威。默认捕获合法模型快照，不全扫源码且来源保持未知；verified及proof显式完整核验。每轮重判技能，正文可复用，变化在同任务追加阶段并保留旧批次。请求ID、进度、有界等待和原回执查询支持失败恢复；归档流式校验及有界正文/响应缓存控制内存。本模型覆盖正式主要模块、文件型知识/技能与冻结原型边界，不声称逐函数或全项目语义覆盖。 初始化/维护使用版本化当前agent指引，源码结构演进时补充、修订或重组模型与视图，保留实体身份和历史；机械覆盖提示不证明语义完整。"
    metadata {
      harness_id "ad94bb95-82f8-4485-b9ac-e1064fcdfa36"
      brief "以LikeC4文本组织项目上下文与文件型技能，通过CLI交接并在Web追溯任务。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000001 d6360000-0000-4000-8000-00000000000b d6360000-0000-4000-8000-00000000000c d6360000-0000-4000-8000-00000000000d d6360000-0000-4000-8000-00000000000e d6360000-0000-4000-8000-00000000000f d6360000-0000-4000-8000-000000000011 4b7bd625-f0d0-4cab-b25c-415b29b9b6f0 580a91f2-72da-4c49-938c-ef31d15863f5 5c648b0f-ccb6-4f46-b367-39c74a3ce972"
      version "12"
    }
    cli = component "CLI入口 · cli/" {
      description "解析参数并输出单个结果封套；stderr先报告requestId及阶段，总等待预算可配置，超时/取消不撤销已接受工作。request status找回原回执，unknown不自动重发。默认snapshot与显式verified分开；资源快捷参数及可省略绑定/哈希由任务记录解析，显式字段继续严格检查。静态帮助提供真实Schema路径，中文JSON优先UTF-8文件；宿主创建进程失败与CLI内权限错误分开。 model maintain支持supplement/revise/rebuild，返回当前agent指引、实际视图覆盖和最近来源观测，不改文件或请求来源全扫。 已有共享上下文只注册，本机仓库关联不改项目文件；旧配对配置修复仍要求已登记项目UUID与原配置哈希。 task select --compact只精简客户端显示，保留当次正文和技能方案，以packetRef恢复完整累计packet；不改变原请求、默认回执或归档。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000001"
      brief "命令发现、严格输入、可恢复RPC与可选精简输出。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000002 d6250000-0000-4000-8000-000000000016 2f63b728-1e83-4ac8-aff3-bd766333ee5e d6360000-0000-4000-8000-000000000003 800efe39-40f9-47b8-a70b-d1819705009e d6370000-0000-4000-8000-000000000002 d6270000-0000-4000-8000-000000000002 f9fd6a5e-1dc9-4263-94bd-68869da716e9 0e67a30f-f14f-43b0-9fe7-9a7ab414c9d5 4eeb09b0-6fc6-4ef1-b5bd-6dcec624f049 aa0b2a7a-539a-423c-9775-d95d64f6dc52 18e28937-86a0-4c30-82c1-f350b72a342b 9d99fef9-ad18-475c-b541-12a01049e49c 935b3fd1-92c7-4a66-ba57-119fcc15bc9a"
      version "13"
      }
    }
    service = component "本机服务 · service/" {
      description "用户数据根共享单实例常驻回环服务，认证CLI/Web并提供RPC、视图及SSE。已接受请求在客户端离开后仍保留执行/提交结果；认证请求进度查询不重发业务。控制端点与后台档案恢复分别报告，活启动所有者不强杀或并起。身份/协议、权限、未知结果及浏览登录边界保持，原任务回执从journal与归档引用恢复。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000002"
        brief "单用户常驻RPC与分类诊断、单实例恢复、浏览会话及worktree事件流。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000003 d6250000-0000-4000-8000-000000000016 0e67a30f-f14f-43b0-9fe7-9a7ab414c9d5 4eeb09b0-6fc6-4ef1-b5bd-6dcec624f049"
        version "8"
      }
    }
    core = component "核心用例 · core/" {
      description "共享的项目身份、文本模型、上下文、技能、历史、索引、观测和同步用例，供CLI与Web使用。 共享错误转换为原生EACCES/EPERM保留系统字段和权限恢复指引，既有业务错误和未知执行结果不被替换。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000003"
        brief "共享核心及按worktree装配的用例和持久化边界。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000004 f9fd6a5e-1dc9-4263-94bd-68869da716e9"
        version "2"
      }
      runtime = component "用例编排 · runtime.ts" {
        description "解析实际工作区并装配独立档案、任务、同步和观测用例。RequestTracker记录临时阶段，在途同意图复用并限制并发/暂存；按明确目标查询原回执，重启从原journal恢复，缺证据保持unknown。档案保留紧凑提交定位，浏览只读已有投影；目录转Git保留身份/资源并使旧来源待核验。 init共用版本化建模指引；model maintain返回结构覆盖与维护工作指引；sync status附pending模型复核提示，不改变完整来源检查和proof。 同仓库配置身份修复通过回调在替换配置前持久记录已有工作区pending，不为修复请求来源全扫；保留已归档任务和原回执。 启动恢复的scope为observation-subscriptions；journal无显式订阅时不预读无关历史正文，CLI/订阅请求保持完整恢复；Web按所请求任务使用派生日志定位与实际字节核验，不等待同步历史或SQLite。浏览全工作区完整性unknown，SSE只读取提交游标。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000012"
          brief "独立的Web只读浏览与完整CLI恢复，保留目标字节核验和核验范围。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000004 0e67a30f-f14f-43b0-9fe7-9a7ab414c9d5 47a9761c-8c69-4907-926f-744ddf8e6ce5 d6360000-0000-4000-8000-000000000006"
          version "10"
        }
      }
      workspace = component "项目身份 · workspace.ts" {
        description "WorkspaceRegistry核对实际根、Git common-dir/origin、项目配置及机器边界。稳定projectId与上下文随项目共享；已有上下文仅register，在本机保存规范仓库关联与旧配置ID，不改项目或Git文件。相同已登记Git仓库的历史项目投影归为一个入口，各工作区及任务保持原UUID和历史字节。相同共享UUID的多个clone登记多个common-dir；旧ID只在显式注册核对后兼容，已知origin漂移、不同远端复用UUID及普通目录不能混用。登记前后核对实际Git身份和配置字节，来源和上下文继续检查本次观察的确切configProjectId。缺失默认本机技能库时创建，已有用户库不覆盖。directory无需Git、按最近边界隔离，原地有效Git转换保留两个UUID；Git损坏不降级。init只建立缺失上下文，语义由当前agent维护；旧配对配置修复保留备份/pending，但不再是同仓库日常注册所需。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000004"
          brief "按目录根或Git仓库定位身份，显式备份校正配置ID，保留工作区隔离与历史。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000005 9a02944d-cbb2-46da-b77f-9c0182486781 18218b5d-a2e7-45cd-bb6c-fec8287ceea2 d6500000-0000-4000-8000-000000000001 9a41ca91-cf24-42ec-8d0c-a9a9af21cf73"
          version "5"
        }
      }
      model = component "文本模型 · model.ts" {
        description "loadModel读取.harness中的LikeC4、证据与别名，检查身份/引用和元数据，并保留带evidenceId的内容异常及本地文档Git归属诊断，再形成目录/正文/C4共用的快照；不改写人工知识状态。 证据格式先校验再解析引用，避免逗号串伪报ID缺失；未声明关系类型给准确DSL修正方式。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000005"
          brief "解析LikeC4与证据/别名，校验稳定身份并生成目录、正文和结构视图。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000006"
          version "3"
        }
      }
      modelMaintenance = component "模型演进 · model-maintenance.ts" {
        description "为当前agent提供补充、修订、重建指引；检查模型拓扑、实际视图及未入图叶对象。只读当前模型/证据，保留非法诊断，最近来源状态不冒充完整核验。agent通过文件工具随实现维护知识和视图，保留同一实体身份与历史，不在后台启动模型。"
        metadata {
          harness_id "80e535ec-2e3b-4287-881a-82f92bd2cafb"
          brief "版本化建模指引、结构/视图覆盖检查与模型演进提示。"
          source "fact"
          status "verified"
          evidence "47a9761c-8c69-4907-926f-744ddf8e6ce5 935b3fd1-92c7-4a66-ba57-119fcc15bc9a ba3cfd1c-08a2-439f-a9fd-32b5dd53f4ec"
          version "1"
        }
      }
      references = component "文档Git归属 · references.ts" {
        description "批量读取Git索引和原生ignore判定，为本地document证据报告未跟踪、忽略或无法核查。诊断只读，不暂存、不改变来源扫描策略，也不要求先提交才能组织上下文。"
        metadata {
          harness_id "51285d7d-1f8e-405d-a729-1363a0940efa"
          brief "对本地项目文档证据提供批量、只读的Git归属诊断。"
          source "fact"
          status "verified"
          evidence "eabb0836-b70b-4b73-aa11-806c7f49c526"
          version "1"
        }
      }
      context = component "任务上下文 · context.ts" {
        description "同步恢复由当前agent按原因和原声明范围重新审核后提交新声明，持续写入明确待核验范围及下一步。TaskService默认捕获模型与技能目录，来源unknown/扫描策略null；snapshot查询读取原模型，verified保持当前完整来源核验。快捷输入从原任务解析绑定和归档哈希。--stage显式追加技能方案，旧批次packet/catalog/plan与原字节保持；正文缓存有界，淘汰后从原journal重核。逐条任务契约、60天读取活动、partial、幂等和关闭边界保持；派生批次索引仅保存定位信息。skill-hub/3在task start/prompt前部提示当前阶段、复杂改动先议或先确认方案、完整正文采用及原回执恢复；仍按实际目录联合选择并保留当前档案接口。结构变化由当前agent复核模型和视图并按实际范围核验；提示不自动执行、清上下文、委派或改写历史。 当前上下文核对registry本次实际观察的精确配置ID，兼容旧ID时仍保留原任务projectId，不能跳过模型/配置版本检查。Web浏览仅恢复目标任务及可见列表，不打开SQLite；一次归档视图合并任务和模型读取，原任务记录/引用及60天边界保持。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000006"
          brief "任务建档与精确交接；Web只读列表及目标恢复不打开SQLite。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000007 eacd2b8f-d6ba-4aa7-9d8a-1536b33662d9 aa0b2a7a-539a-423c-9775-d95d64f6dc52 18e28937-86a0-4c30-82c1-f350b72a342b 9a41ca91-cf24-42ec-8d0c-a9a9af21cf73"
          version "13"
        }
      }
      skills = component "技能文件 · skills/catalog" {
        description "scanSkills从实际根目录派生轻目录和诊断，captureSkills保留选择时文件及哈希。首次seed不覆盖用户目录，方法引用不自动加入也不执行脚本。 CatalogObserver为浏览请求共享在途扫描和已检查目录，原生通知失效、周期补偿及显式刷新仍重新检查；任务选择独立捕获当前技能字节。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000007"
          brief "按实际文件扫描技能目录、核对引用与版本，并为所选文件保留字节。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000008 d6390000-0000-4000-8000-000000000001"
          version "2"
        }
      }
      archive = component "文件历史 · archive.ts" {
        description "journal与内容寻址snapshot/blob保留原提交事实。完整CLI/订阅恢复流式验证完整记录、哈希链和所有引用，独立引用单轮去重并最多8路读取。Web使用只读requested模式，以browse-index派生日志位置读取并重核实际首尾、目标提交及引用；日志身份/长度/时间只作缓存失效，不能证明内容或来源。首次缺索引重核日志链，合法追加从原末端指纹核对后续提交；缓存失败不改变已持久提交。浏览全工作区完整性为unknown，不成为写请求/proof捷径。私有committedKind检查完整journal路由订阅并可生成定位缓存，不证明历史正文；原历史不删除或改写。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000008"
          brief "完整档案核验与可重建浏览定位分离，按请求核对原字节。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000009 d6360000-0000-4000-8000-000000000008 d6360000-0000-4000-8000-000000000006 e477f084-e25b-4733-a542-64986ce9f392 99c891dd-28b7-4f76-83e9-4709a6f6fc31 b34c74e1-cdf9-44c7-8faa-206148cf3c0e"
          version "6"
        }
      }
      index = component "派生索引 · index.ts" {
        description "SearchIndex通过固定类型消息调用index-worker中的node:sqlite。任务/实体/批次/事件投影可重建，索引不是项目模型或历史的第二套权威。 catchUp校验连续范围并在同一事务更新受影响文档与索引游标，通用事件不重复复制完整状态payload。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000009"
          brief "在worker内维护可由归档重建的SQLite投影与检索。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000a d6390000-0000-4000-8000-000000000002"
          version "2"
        }
      }
      source = component "源码与同步 · source/freshness" {
        description "同步区分确定的Git临时维护通知与真实来源变化；只读status有界完整重采，持续活动保持pending并明确下一步；verify保留严格CAS和字节回退保护，竞态回执给出原因、审核范围及当次状态。source.ts以有界原生Git批量查询按目录层判定忽略规则、按UTF-8字节分块stdin，保留argv限制、链接祖先守卫、外部filter拒绝、两遍原字节及前后状态核验；管道失败保持来源unknown。freshness.ts在目录排除前处理显式引用，同时观测声明路径和经过工作区边界检查的真实目标，目标暂缺时保留最后安全目标用于观测重建。引用变更和字节回退推进代次，不扩展来源manifest；范围核验及pending清理统一处理链接与Windows大小写等价路径。成功模型的证据异常保留，命中范围不能被声明清除，无关局部proof可保存且未解决部分仍pending；目录通知只将受影响的引用文件标pending，不额外加入目录范围；单文件核验保留同目录其它引用的待核验状态。机械核验不等于语义理解。 日常变化按路径合并读取，sourceObservation单列观测范围/指纹/时间/代次，保留上次完整来源和scanPending；缺口/策略/目录变化完整补偿，忽略输出不推进来源代次。同目标status共享在途完整检查，任务绑定与verify的两遍字节/提交前复核保持。新状态日志引用原receipt状态快照并兼容旧inline记录，不改写历史。 嵌套仓库明确报告独立来源边界，不自动遍历或排除；同步冲突回执附期望/实际字段及重新审核后新建声明的恢复指引，严格CAS与旧回执保留。 普通目录适配器复用叶条目、原字节及链接边界核对，完整成功为unversioned；ignore@7.0.14读取根和嵌套.gitignore，扫描与新路径监听复用同一规则。两遍枚举/字节检查及策略指纹保留严格代次/CAS；嵌套项目或仓库未显式排除时unknown，Git原有指纹不改写。 identityRepairPending在配置恢复前持久推进代次并保持pending，冷服务及重启不能因字节恢复复用旧proof。 目录消失或原生通知失去安全路径时释放监听，保留unknown/pending及历史；定期检查原路径恢复并重新完整核验，不持续自激写档。恢复最多8路读取同步状态，但按journal顺序检查target与单调代次。新proof的scopeStatus明确原声明范围，全局state与其他pending独立。 Git来源扫描核对本次登记认可且实际观察的configProjectId和完整配置字节，旧ID兼容不放宽双遍扫描、epoch或proof CAS。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000a"
          brief "完整来源与严格声明核验，观测覆盖丢失时收敛并保留待核验。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000b d6250000-0000-4000-8000-00000000000c e94d7f43-9e04-4d1d-872f-b8125998f02e bf342397-819c-4a86-8c9c-1b9686af9b17 b8983113-8884-4915-a339-4106142e7407 9a02944d-cbb2-46da-b77f-9c0182486781 ff040559-643c-4bfd-8584-d507e92d0bdf f11ba75e-586a-4e73-916f-a588e214dc8a 9a41ca91-cf24-42ec-8d0c-a9a9af21cf73"
          version "12"
        }
      }
      observation = component "只读观测 · observation.ts" {
        description "ObservationManager只读取明确绑定的已有宿主日志，保留可识别的调用、结果、检查点与覆盖缺口；不装Hooks、不扫描未知会话，不把文件变化当作读取。Web归档投影采用只读模式，不获取日志租约或启动轮询。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000b"
          brief "显式绑定日志的只读观测；网页归档展示不获取日志租约或启动轮询。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000d"
          version "2"
        }
      }
      maintenance = component "维护 · maintenance.ts" {
        description "MigrationService显式复制原型档案并保留来源、当时ID和字节；普通legacy列表及格式检查复用所属Runtime档案或Web requested读者，以提交头定位正式任务；Web旧格式原文继续校验原归档闭包。显式迁移和所请求旧归档继续核对原字节。GC只回收明确可再生/未提交产物，保留历史和用户技能，恢复期间不执行apply。"
