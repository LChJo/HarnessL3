specification {
  element system
  element component
  element artifact
  relationship uses
  relationship guides
  relationship verifies
}
model {
  app = system "HarnessL3" {
    description "面向现有AI Agent的项目上下文CLI。本机服务稳定连接与提交一致性优先；此模型覆盖正式主模块、文件型知识与技能、文档留存/证据核验、关键静态依赖和冻结原型边界；不声称覆盖每个函数或全部业务语义。"
    metadata {
      harness_id "ad94bb95-82f8-4485-b9ac-e1064fcdfa36"
      brief "以LikeC4文本组织项目上下文与文件型技能，通过CLI交接并在Web追溯任务。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000001"
      version "6"
    }
    cli = component "CLI入口 · cli/" {
      description "解析参数、发现帮助并输出单个结果封套；普通命令直接认证RPC，不依赖独立探活。连接拒绝或执行前拒绝可重读定位并有界重连，保持requestId；响应丢失保留结果未知，不盲目重发写请求。状态查询区分运行、停止、排空、不可用和冲突。保留UTF-8请求文件和上下文返回后输出卡片约定，不启动agent或执行技能。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000001"
        brief "harnessl3命令与输入契约、RPC直连/有界恢复及文本/JSON输出。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000002 d6250000-0000-4000-8000-000000000016 2f63b728-1e83-4ac8-aff3-bd766333ee5e"
        version "4"
      }
    }
    service = component "本机服务 · service/" {
      description "默认用户数据根共享一份常驻回环HTTP服务，认证CLI/Web访问并提供RPC、视图和SSE。本机连接稳定性优先：健康检查仅用于状态/启动诊断，区分暂时不可用与身份/协议冲突；PID只作恢复线索。业务分派前核对可选实例/数据根头，保留协议1旧客户端；确认退出后在单实例锁下恢复，stop不依赖探活、不强杀未知进程。网页会话及显式数据根隔离边界保持。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000002"
        brief "单用户常驻RPC与分类诊断、单实例恢复、浏览会话及worktree事件流。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000003 d6250000-0000-4000-8000-000000000016"
        version "3"
      }
    }
    core = component "核心用例 · core/" {
      description "共享的项目身份、文本模型、上下文、技能、历史、索引、观测和同步用例，供CLI与Web使用。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000003"
        brief "共享核心及按worktree装配的用例和持久化边界。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000004"
        version "1"
      }
      runtime = component "用例编排 · runtime.ts" {
        description "core/runtime.ts中的Runtime按worktree装配资源。命令分派、view构建及只读日志绑定共用这些实例；初始化结果只报告机械接入和当前模型数量。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000012"
          brief "解析目标，装配独立worktree资源，并将命令分派到核心用例。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000004"
          version "1"
        }
      }
      workspace = component "项目身份 · workspace.ts" {
        description "WorkspaceRegistry读取实际Git root/common-dir与项目UUID，拒绝目标或路径重叠冲突；init仅建立缺失文件和首次技能库，register保留已有模型。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000004"
          brief "登记已有Git worktree，核查身份、路径隔离并建立缺失上下文文件。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000005"
          version "1"
        }
      }
      model = component "文本模型 · model.ts" {
        description "loadModel读取.harness中的LikeC4、证据与别名，检查身份/引用和元数据，并保留带evidenceId的内容异常及本地文档Git归属诊断，再形成目录/正文/C4共用的快照；不改写人工知识状态。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000005"
          brief "解析LikeC4与证据/别名，校验稳定身份并生成目录、正文和结构视图。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000006"
          version "2"
        }
      }
      references = component "文档Git归属 · references.ts" {
        description "批量读取Git索引和原生ignore判定，为本地document证据报告未跟踪、忽略或无法核查。诊断只读，不暂存、不改变来源扫描策略，也不要求先提交才能组织上下文。"
        metadata {
          harness_id "51285d7d-1f8e-405d-a729-1363a0940efa"
          brief "对本地项目文档证据提供批量、只读的Git归属诊断。"
          source "fact"
          status "verified"
          evidence "eabb0836-b70b-4b73-aa11-806c7f49c526"
          version "1"
        }
      }
      context = component "任务上下文 · context.ts" {
        description "TaskService处理start/select/query/handoff/read/close及历史。入口规则包含长期文档增删改移后的模型/证据维护、Git归属和本机数据边界；联合选择只记录一次，精确正文和已选技能字节归档，旧回执不改写。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000006"
          brief "任务建档、一次联合选择、精确查询、归档交接和技能正文读取。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000007"
          version "3"
        }
      }
      skills = component "技能文件 · skills.ts" {
        description "scanSkills从实际根目录派生轻目录和诊断，captureSkills保留选择时文件及哈希。首次seed不覆盖用户目录，方法引用不自动加入也不执行脚本。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000007"
          brief "按实际文件扫描技能目录、核对引用与版本，并为所选文件保留字节。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000008"
          version "1"
        }
      }
      archive = component "文件历史 · archive.ts" {
        description "Archive以journal提交为事实，保存内容寻址snapshot/blob和请求回执。幂等重放保留已提交字节；恢复不能用当前模型或技能补造历史。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000008"
          brief "保存journal提交、幂等回执、快照和技能字节，按已提交事实恢复。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000009"
          version "1"
        }
      }
      index = component "派生索引 · index.ts" {
        description "SearchIndex通过固定类型消息调用index-worker中的node:sqlite。任务/实体/批次/事件投影可重建，索引不是项目模型或历史的第二套权威。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000009"
          brief "在worker内维护可由归档重建的SQLite投影与检索。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000a"
          version "1"
        }
      }
      source = component "源码与同步 · source/freshness" {
        description "source.ts按Git及忽略策略核对原始文件；freshness.ts在目录排除前处理显式引用，同时观测声明路径和经过工作区边界检查的真实目标，目标暂缺时保留最后安全目标用于观测重建。引用变更和字节回退推进代次，不扩展来源manifest；范围核验及pending清理统一处理链接与Windows大小写等价路径。成功模型的证据异常保留，命中范围不能被声明清除，无关局部proof可保存且未解决部分仍pending；目录通知只将受影响的引用文件标pending，不额外加入目录范围；单文件核验保留同目录其它引用的待核验状态。机械核验不等于语义理解。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000a"
          brief "观测来源及显式引用的真实目标，保留证据异常和实际范围的同步声明。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000b d6250000-0000-4000-8000-00000000000c e94d7f43-9e04-4d1d-872f-b8125998f02e"
          version "4"
        }
      }
      observation = component "只读观测 · observation.ts" {
        description "ObservationManager只读取明确绑定的已有宿主日志，保留可识别的调用、结果、检查点与覆盖缺口；不装Hooks、不扫描未知会话，不把文件变化当作读取。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000b"
          brief "读取显式绑定的Codex/Claude Code日志，将支持的调用/结果保留为有限观测。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000d"
          version "1"
        }
      }
      maintenance = component "维护 · maintenance.ts" {
        description "MigrationService显式复制原型档案并保留来源、当时ID和字节；任务格式检查复用所属服务已加载的journal，所请求的归档仍核对字节。GarbageCollector只回收明确可再生/未提交产物，历史和用户技能不作为临时垃圾。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000c"
          brief "显式复制原型档案、只读恢复旧记录，以及保守回收确定可再生数据。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000e"
          version "2"
        }
      }
    }
    web = component "可视化工作台 · web/" {
      description "React主入口main.tsx通过api.ts访问同源服务，浏览由agent经CLI建立的任务，不提供网页新建入口或关闭标签；首屏只显示加载状态，同目标刷新合并且不取消首个请求。五类与技能逐层只展命中及祖先；父对象自身正文返回时保留正文叶子和输出路径，不重复计数。其余以省略节点进入DirectoryPage独立搜索/分页列表，返回保留相机；401显示登录恢复状态。明显损坏的技能选择理由给疑似编码提示，可展开原文；不猜写档案。历史保持当时模型/目录/技能引用，浏览不制造上下文读取。"
      metadata {
        harness_id "c6250000-0000-4000-8000-00000000000d"
        brief "显示任务五类脑图、文件夹Skill Hub、项目结构、历史及真实状态。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-00000000000f d6250000-0000-4000-8000-000000000010 d6250000-0000-4000-8000-000000000018 d6250000-0000-4000-8000-000000000019 d6250000-0000-4000-8000-00000000001a fd73b46e-52f4-4779-9daf-314249502ea4 0e16b65c-8bb4-4dc2-be03-cc93b19fe707"
        version "6"
      }
    }
    runtimeSkill = artifact "Agent入口 · agent-skills/" {
      description "harnessl3/SKILL.md及按需参考指导已有agent先组织上下文；独立安装器通过Node主模块标识识别直接调用，兼容临时目录别名和链接入口，作为模块导入时不执行安装；中文JSON优先写入worktree外UTF-8文件，明确字节的stdin仍可用；实际上下文和必要技能正文返回后，取得真实链接，在进度消息中展示一次查看HarnessL3的输出引用卡片，再继续标准工作，最终答复不重复。首次确认后由当前大模型直接建模；源码/文档/知识阶段均维护当前关联与证据，移动保留身份、删除保留历史，区分长期文档和本机task记录。权威上下文随相关源码版本管理，项目技能按真实文件归属纳入，本机数据及外部技能库排除，提交遵守已有授权。"
      metadata {
        harness_id "c6250000-0000-4000-8000-00000000000e"
        brief "指导当前agent接入、阅读/建模、选择/交接上下文和报告真实进度。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000011 7f0df0da-7a72-47aa-8953-343a7927cb24 c0bf2ca0-ae94-4381-9c25-b72abe3b2f30"
        version "8"
      }
    }
    library = artifact "可编辑方法 · skills/" {
      description "随包普通方法和附件首次播种到用户库，之后以实际配置文件为准，升级不覆盖用户库。默认方法自包含，移除跨技能和库根说明引用，保留同方法实际附件；用户related候选仍兼容且不自动归档。文档产出方法在留存步骤衔接当前上下文/证据及Git归属维护，quick在需核查长期关联时退出；选择/读取不等于执行。"
      metadata {
        harness_id "c6250000-0000-4000-8000-00000000000f"
        brief "Skill Hub的文件型方法来源、相关引用和附件，不是自动执行工作流。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000012 04fbf739-c340-4ea7-9b55-80a266ca4b00"
        version "3"
      }
    }
    projectModel = artifact "权威上下文 · .harness/" {
      description "project.json保存Git内项目身份与相对配置，model/中的.c4/.likec4表达对象、关系与视图，evidence.json与aliases.json保存依据和身份迁移；引用的长期项目文档与模型及相关源码共同审阅。项目任务Markdown与本机task历史分开，临时目录名不决定留存。端口、机器绝对路径、访问凭证及运行历史保存在机器数据根。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000013"
        brief "随Git保存的LikeC4文本、项目配置、证据及别名；由当前agent直接维护。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000015 e553d996-f21a-4af0-bc7c-eec02753f102"
        version "3"
      }
    }
    quality = component "隔离验证 · tests/v1与web验证" {
      description "Node测试和正式Web验证使用临时Git与隔离数据根；安装消费者经中文链接目录检查真实入口及安装包Schema，兼容路径别名。程序回归覆盖技能安装、链接通知和局部核验，以及本机服务探活不可用但RPC正常、慢响应/状态分类、端点轮转、死亡恢复、实例归属和停止重连；真实临时档案验证提交后丢响应不会重复创建任务，原requestId可回放。每轮/平台结果独立记录，源码中存在测试不代表它本次已运行。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000010"
        brief "通过临时Git、独立数据根、程序/浏览器与安装消费者核对正式契约。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000013 d6250000-0000-4000-8000-000000000017 deda538a-cccc-4f64-9909-86d4445ed1d0 c7e37e35-b20f-45d8-b816-8ad845bdb602 1e950683-1469-49c8-9164-d439932a7bf2 45053a0a-4b0c-446a-b495-f43b34a6486c 1adbda54-d648-4a22-a7b0-cf7f7a7ad845 f3392c10-b6b2-4bfb-aa3a-e7860e44c55a"
        version "7"
      }
    }
    prototype = component "冻结原型参考 · src/server/examples" {
      description "保留v0.16交互、原型实现及MGRP示例作历史/复用参考；不是正式CLI产品默认业务，也不是新的运行时模块。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000011"
        brief "与正式core/cli/service/web分开的历史原型和只读业务示例。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000014"
        version "1"
      }
    }
  }
}
