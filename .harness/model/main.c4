specification {
  element system
  element component
  element artifact
  relationship uses
  relationship guides
  relationship verifies
}
model {
  app = system "HarnessL3" {
    description "面向现有AI Agent的项目上下文CLI；现有agent每轮按当前操作筛选并读取技能，项目上下文可跨轮复用。本机服务稳定连接、历史恢复与提交一致性优先；安装核对构建来源及适用的旧交接。本模型覆盖正式主模块、文件型知识与技能、文档留存/证据核验、关键静态依赖和冻结原型边界；不声称覆盖每个函数或全部业务语义。 观察复盘读取已有任务和最近状态；日常编码变化增量观测，严格任务绑定与阶段核验保留完整检查。"
    metadata {
      harness_id "ad94bb95-82f8-4485-b9ac-e1064fcdfa36"
      brief "以LikeC4文本组织项目上下文与文件型技能，通过CLI交接并在Web追溯任务。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000001 d6360000-0000-4000-8000-00000000000b d6360000-0000-4000-8000-00000000000c d6360000-0000-4000-8000-00000000000d d6360000-0000-4000-8000-00000000000e d6360000-0000-4000-8000-00000000000f d6360000-0000-4000-8000-000000000011 4b7bd625-f0d0-4cab-b25c-415b29b9b6f0"
      version "9"
    }
    cli = component "CLI入口 · cli/" {
      description "解析参数、发现帮助并输出单个结果封套；静态帮助显示构建来源及共享Schema的known用途，校验错误定位字段、约束与适用修正提示，不回显请求值。调用指引先判ok、分开stdout/stderr并保存CLI退出码。普通命令直接认证RPC，不依赖独立探活；仅确认执行前失败可有界重连并保持requestId，响应丢失不盲目重发写请求。初始化活锁不伪报已停止；保留UTF-8文件、输出卡片及现有agent主动调用边界。 帮助列出真实本地引用Schema路径；初始化与模型校验提供安装端建模语法和使用说明入口。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000001"
        brief "命令发现、字段校验与修正提示、RPC恢复及真实CLI输出状态。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000002 d6250000-0000-4000-8000-000000000016 2f63b728-1e83-4ac8-aff3-bd766333ee5e d6360000-0000-4000-8000-000000000003 800efe39-40f9-47b8-a70b-d1819705009e d6370000-0000-4000-8000-000000000002 d6270000-0000-4000-8000-000000000002"
        version "7"
      }
    }
    service = component "本机服务 · service/" {
      description "默认用户数据根共享常驻回环HTTP服务，认证CLI/Web并提供RPC、视图和SSE。路径隔离预检后发布控制端点，档案及显式订阅在后台恢复；健康状态分别报告运行和恢复进度，目标请求仍等待自己的完整资源。活启动锁期间有界等待原所有者，无认证停止端点时返回BUSY。网页认证区分缺少会话、过期码与无效或已用码，已有会话检查不轮换或续期。保留协议1、请求身份、未知进程保护、提交排空及网页凭证边界。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000002"
        brief "单用户常驻RPC与分类诊断、单实例恢复、浏览会话及worktree事件流。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000003 d6250000-0000-4000-8000-000000000016"
        version "5"
      }
    }
    core = component "核心用例 · core/" {
      description "共享的项目身份、文本模型、上下文、技能、历史、索引、观测和同步用例，供CLI与Web使用。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000003"
        brief "共享核心及按worktree装配的用例和持久化边界。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000004"
        version "1"
      }
      runtime = component "用例编排 · runtime.ts" {
        description "Runtime在监听前预检数据根隔离，后台恢复已有档案和显式订阅，按worktree共享Archive加载Promise与用例资源。目标请求等待自己的验证结果，恢复进度保留失败；订阅恢复与登记变更串行，恢复期间拒绝GC apply，关闭等待在途恢复。初始化仍只报告机械接入和模型数量。普通Web视图只读已记录模型/状态，不执行来源重扫；当前模型等待解析或未知时保留unknown及最近有效快照，不以旧图代替当前valid。目录浏览复用CatalogObserver，同一服务的后台观测有界排队。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000012"
          brief "解析目标，装配独立worktree资源，并将命令分派到核心用例。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000004"
          version "4"
        }
      }
      workspace = component "项目身份 · workspace.ts" {
        description "WorkspaceRegistry读取实际Git root/common-dir与项目UUID，拒绝目标或路径重叠冲突；未登记Git工作区返回待询问的接入指引、实际路径与影响，回退仅用于拒绝/取消。init仅建立缺失文件和首次技能库，register保留已有模型。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000004"
          brief "核查已有Git工作区身份与路径，未登记时要求先询问接入。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000005"
          version "2"
        }
      }
      model = component "文本模型 · model.ts" {
        description "loadModel读取.harness中的LikeC4、证据与别名，检查身份/引用和元数据，并保留带evidenceId的内容异常及本地文档Git归属诊断，再形成目录/正文/C4共用的快照；不改写人工知识状态。 证据格式先校验再解析引用，避免逗号串伪报ID缺失；未声明关系类型给准确DSL修正方式。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000005"
          brief "解析LikeC4与证据/别名，校验稳定身份并生成目录、正文和结构视图。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000006"
          version "3"
        }
      }
      references = component "文档Git归属 · references.ts" {
        description "批量读取Git索引和原生ignore判定，为本地document证据报告未跟踪、忽略或无法核查。诊断只读，不暂存、不改变来源扫描策略，也不要求先提交才能组织上下文。"
        metadata {
          harness_id "51285d7d-1f8e-405d-a729-1363a0940efa"
          brief "对本地项目文档证据提供批量、只读的Git归属诊断。"
          source "fact"
          status "verified"
          evidence "eabb0836-b70b-4b73-aa11-806c7f49c526"
          version "1"
        }
      }
      context = component "任务上下文 · context.ts" {
        description "TaskService处理start/select/query/handoff/read/close及历史；逐条恢复任务契约，按目标任务的归档引用核对当时字节，事件投影读取提交头而不复制无关任务正文。入口保留文档维护、Git归属和本机边界；联合选择只记录一次，旧回执和60天读取基准不改写。 通用事件仅投影提交头和回执引用；索引连续缺口以事务增量追赶，旧投影格式只重建派生数据。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000006"
          brief "任务建档、一次联合选择、精确查询、归档交接和技能正文读取。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000007"
          version "5"
        }
      }
      skills = component "技能文件 · skills/catalog" {
        description "scanSkills从实际根目录派生轻目录和诊断，captureSkills保留选择时文件及哈希。首次seed不覆盖用户目录，方法引用不自动加入也不执行脚本。 CatalogObserver为浏览请求共享在途扫描和已检查目录，原生通知失效、周期补偿及显式刷新仍重新检查；任务选择独立捕获当前技能字节。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000007"
          brief "按实际文件扫描技能目录、核对引用与版本，并为所选文件保留字节。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000008 d6390000-0000-4000-8000-000000000001"
          version "2"
        }
      }
      archive = component "文件历史 · archive.ts" {
        description "Archive以journal为提交事实，保存内容寻址snapshot/blob和幂等回执。按提交类型/任务派生定位，扫描固定调用边界并返回副本，头和引用查询不复制无关正文；恢复轮次内去重引用校验，解析分段让出事件循环。哈希链、损坏区域和后续请求的原字节核对保持，不永久信任缓存或以当前内容补历史。 提交头提供时间、操作身份与按序号过滤，支持紧凑派生投影，原journal与归档原字节保持。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000008"
          brief "保存journal提交、幂等回执、快照和技能字节，按已提交事实恢复。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000009"
          version "3"
        }
      }
      index = component "派生索引 · index.ts" {
        description "SearchIndex通过固定类型消息调用index-worker中的node:sqlite。任务/实体/批次/事件投影可重建，索引不是项目模型或历史的第二套权威。 catchUp校验连续范围并在同一事务更新受影响文档与索引游标，通用事件不重复复制完整状态payload。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000009"
          brief "在worker内维护可由归档重建的SQLite投影与检索。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000a d6390000-0000-4000-8000-000000000002"
          version "2"
        }
      }
      source = component "源码与同步 · source/freshness" {
        description "source.ts以有界原生Git批量查询按目录层判定忽略规则、按UTF-8字节分块stdin，保留argv限制、链接祖先守卫、外部filter拒绝、两遍原字节及前后状态核验；管道失败保持来源unknown。freshness.ts在目录排除前处理显式引用，同时观测声明路径和经过工作区边界检查的真实目标，目标暂缺时保留最后安全目标用于观测重建。引用变更和字节回退推进代次，不扩展来源manifest；范围核验及pending清理统一处理链接与Windows大小写等价路径。成功模型的证据异常保留，命中范围不能被声明清除，无关局部proof可保存且未解决部分仍pending；目录通知只将受影响的引用文件标pending，不额外加入目录范围；单文件核验保留同目录其它引用的待核验状态。机械核验不等于语义理解。 日常变化按路径合并读取，sourceObservation单列观测范围/指纹/时间/代次，保留上次完整来源和scanPending；缺口/策略/目录变化完整补偿，忽略输出不推进来源代次。同目标status共享在途完整检查，任务绑定与verify的两遍字节/提交前复核保持。新状态日志引用原receipt状态快照并兼容旧inline记录，不改写历史。 嵌套仓库明确报告独立来源边界，不自动遍历或排除；同步冲突回执附期望/实际字段及重新审核后新建声明的恢复指引，严格CAS与旧回执保留。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000a"
          brief "按路径增量观测并保留完整来源核验、证据异常和同步范围。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000b d6250000-0000-4000-8000-00000000000c e94d7f43-9e04-4d1d-872f-b8125998f02e bf342397-819c-4a86-8c9c-1b9686af9b17 b8983113-8884-4915-a339-4106142e7407"
          version "7"
        }
      }
      observation = component "只读观测 · observation.ts" {
        description "ObservationManager只读取明确绑定的已有宿主日志，保留可识别的调用、结果、检查点与覆盖缺口；不装Hooks、不扫描未知会话，不把文件变化当作读取。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000b"
          brief "读取显式绑定的Codex/Claude Code日志，将支持的调用/结果保留为有限观测。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000d"
          version "1"
        }
      }
      maintenance = component "维护 · maintenance.ts" {
        description "MigrationService显式复制原型档案并保留来源、当时ID和字节；普通legacy列表及格式检查复用所属Runtime已验证档案，以提交头定位正式任务。显式迁移和所请求旧归档继续核对原字节。GC只回收明确可再生/未提交产物，保留历史和用户技能，恢复期间不执行apply。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000c"
          brief "显式复制原型档案、只读恢复旧记录，以及保守回收确定可再生数据。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000e"
          version "3"
        }
      }
    }
    web = component "可视化工作台 · web/" {
      description "React主入口main.tsx通过api.ts访问同源服务，浏览由agent经CLI建立的任务，不提供网页新建入口或关闭标签；首屏只显示加载状态，同目标刷新合并且不取消首个请求。五类与技能逐层只展命中及祖先；父对象自身正文返回时保留正文叶子和输出路径，不重复计数。其余以省略节点进入DirectoryPage独立搜索/分页列表，返回保留相机。登录在认证及浏览器会话确认后才去码；中断保留原链接及重试，Cookie未保存单独提示，同页新登录片段重新加载认证，401保留实际原因。明显损坏的技能选择理由给疑似编码提示，可展开原文；不猜写档案。历史保持当时模型/目录/技能引用，浏览不制造上下文读取。项目切换恢复会话内上次查看的工作区/可见任务/批次；首屏50条外按记住的ID查可见历史并分页精确匹配，查询失败保留记忆，确认不可见才回退最近任务。无任务保持空状态；明确当前工作区只展示最近观测，等待解析或未知模型显示最近有效版本。首响应已覆盖的SSE不补取，历史页只提示相关更新，任务列表按相关提交刷新。"
      metadata {
        harness_id "c6250000-0000-4000-8000-00000000000d"
        brief "跨历史分页恢复可见任务，保留模型当前状态，显示五类和技能层及隐藏计数。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-00000000000f d6250000-0000-4000-8000-000000000010 d6250000-0000-4000-8000-000000000018 d6250000-0000-4000-8000-000000000019 d6250000-0000-4000-8000-00000000001a fd73b46e-52f4-4779-9daf-314249502ea4 0e16b65c-8bb4-4dc2-be03-cc93b19fe707"
        version "10"
      }
    }
    runtimeSkill = artifact "Agent入口 · agent-skills/" {
      description "harnessl3/SKILL.md及四份参考以英文说明每轮技能路由、项目上下文复用、按需处理接入和请求结果。每轮按当前操作重判并task read所选技能正文；同技能/合适版本复用选择，技能集合或所需版本变化新建阶段任务，一次选择本轮技能及缺失上下文；空选不冒充继承旧packet或跨任务known。仅丢失才恢复、缺新上下文才差量读，接入事实及授权复用，归档恢复不要求重初始化；计划、技能切换或回复结束不自动关闭未完成任务。入口遇到onboarding优先询问初始化/登记，必须调用当前宿主/模式实际可用且允许的原生询问工具；一次一问并等待，异步返回不等于同意。仅拒绝或取消才本任务普通执行。确认后直接建模并维护文档/证据/Git归属；正文返回后展示一次真实输出卡片。安装按唯一INSTALL指南保留旧包，核对源提交、运行文件指纹及实际服务/RPC；已有L3交接先保存UTF-8原包再只读比较，未提供明确未检查。显式安装和验证工具使用Node主模块标识兼容目录别名与链接；保留机器历史、用户技能及既有提交授权边界。 初始化先读安装端模型示例，按帮助实际路径取得契约；修复保留UUID，失败不访问成功data，嵌套范围与新同步声明需真实审核。"
      metadata {
        harness_id "c6250000-0000-4000-8000-00000000000e"
        brief "逐轮读取技能并复用上下文；首次接入实际调用原生询问工具，保留待答、历史与调用边界。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000011 7f0df0da-7a72-47aa-8953-343a7927cb24 c0bf2ca0-ae94-4381-9c25-b72abe3b2f30 d6360000-0000-4000-8000-000000000001 d6360000-0000-4000-8000-000000000002 d6360000-0000-4000-8000-000000000003 d6360000-0000-4000-8000-000000000004 d6360000-0000-4000-8000-000000000005 d6270000-0000-4000-8000-000000000001 d6270000-0000-4000-8000-000000000002 d6370000-0000-4000-8000-000000000001 d6370000-0000-4000-8000-000000000005 f0aebaaa-4e29-4f81-90e2-ce786eb7ee3d"
        version "16"
      }
    }
    library = artifact "可编辑方法 · skills/" {
      description "随包普通方法和附件首次播种到用户库，之后以实际配置文件为准，升级不覆盖用户库。默认方法自包含，移除跨技能和库根说明引用，保留同方法实际附件；用户related候选仍兼容且不自动归档。文档产出方法在留存步骤衔接当前上下文/证据及Git归属维护，quick在需核查长期关联时退出；选择/读取不等于执行。"
      metadata {
        harness_id "c6250000-0000-4000-8000-00000000000f"
        brief "Skill Hub的文件型方法来源、相关引用和附件，不是自动执行工作流。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000012 04fbf739-c340-4ea7-9b55-80a266ca4b00"
        version "3"
      }
    }
    projectModel = artifact "权威上下文 · .harness/" {
      description "project.json保存Git内项目身份与相对配置，model/中的.c4/.likec4表达对象、关系与视图，evidence.json与aliases.json保存依据和身份迁移；引用的长期项目文档与模型及相关源码共同审阅。项目任务Markdown与本机task历史分开，临时目录名不决定留存。端口、机器绝对路径、访问凭证及运行历史保存在机器数据根。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000013"
        brief "随Git保存的LikeC4文本、项目配置、证据及别名；由当前agent直接维护。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000015 e553d996-f21a-4af0-bc7c-eec02753f102"
        version "3"
      }
    }
    quality = component "隔离验证 · tests/v1与web验证" {
      description "Node与Web验证使用临时Git和隔离数据根，覆盖既有连接、提交、技能及原型监听门禁。来源批量查询回归覆盖UTF-8字节边界、文件/忽略变化、等待及判定后的祖先链接替换和stdin故障；独立合成CLI比较启动、RSS、实际上下文/技能字节及重启交接。恢复检查覆盖阻塞时控制RPC可用/GC互斥、活锁不伪报停止、单档案恢复与引用去重、已知ID不复制无关正文及后续损坏。登录检查覆盖首次与确认请求中断、Cookie缺失、同页新链接恢复、过期原因及浏览不改任务。中文链接目录中的真实安装消费者检查构建/服务指纹、旧交接一致及差异失败；双worktree完整合成历史分别测控制就绪、首次交接总耗时、热读取和RSS，并核对journal不变。连续阶段CLI验证覆盖票据转实现、同技能逐轮正文返回、空选及原任务/留存基准不变。每轮/平台独立留证，测试存在不等于本轮已通过。 增量观测验证实际读取范围与全量条目一致、祖先链接不跟随、字节回退代次、紧凑状态兼容恢复和索引增量/重建等价；浏览门禁检查恢复任务/工作区、无任务、序号去重、历史不续期及只提示更新。只读Codux副本单独测冷热读取、索引体积和定向观察，原档案指纹保持；单样本不作为SLA。审查回归覆盖首屏之外的任务/批次恢复、搜索分页精确ID、查询失败与不可见回退，以及真实模型变更等待解析时的旧快照与unknown投影。 初始化回归覆盖可校验安装示例、嵌套仓库的显式恢复、失败封套保护和仅epoch变化的冲突回放；包验证检查帮助引用在实际安装目录可读。"
