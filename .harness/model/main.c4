specification {
  element system
  element component
  element artifact
  relationship uses
  relationship guides
  relationship verifies
}
model {
  app = system "HarnessL3" {
    description "面向现有agent的项目上下文CLI，以LikeC4文本为权威。默认捕获合法模型快照，不全扫源码且来源保持未知；verified及proof显式完整核验。每轮重判技能，正文可复用，变化在同任务追加阶段并保留旧批次。请求ID、进度、有界等待和原回执查询支持失败恢复；归档流式校验及有界正文/响应缓存控制内存。本模型覆盖正式主要模块、文件型知识/技能与冻结原型边界，不声称逐函数或全项目语义覆盖。 初始化/维护使用版本化当前agent指引，源码结构演进时补充、修订或重组模型与视图，保留实体身份和历史；机械覆盖提示不证明语义完整。"
    metadata {
      harness_id "ad94bb95-82f8-4485-b9ac-e1064fcdfa36"
      brief "以LikeC4文本组织项目上下文与文件型技能，通过CLI交接并在Web追溯任务。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000001 d6360000-0000-4000-8000-00000000000b d6360000-0000-4000-8000-00000000000c d6360000-0000-4000-8000-00000000000d d6360000-0000-4000-8000-00000000000e d6360000-0000-4000-8000-00000000000f d6360000-0000-4000-8000-000000000011 4b7bd625-f0d0-4cab-b25c-415b29b9b6f0 580a91f2-72da-4c49-938c-ef31d15863f5 5c648b0f-ccb6-4f46-b367-39c74a3ce972"
      version "12"
    }
    cli = component "CLI入口 · cli/" {
      description "解析参数并输出单个结果封套；stderr先报告requestId及阶段，总等待预算可配置，超时/取消不撤销已接受工作。request status找回原回执，unknown不自动重发。默认snapshot与显式verified分开；资源快捷参数及可省略绑定/哈希由任务记录解析，显式字段继续严格检查。静态帮助提供真实Schema路径，中文JSON优先UTF-8文件；宿主创建进程失败与CLI内权限错误分开。 model maintain支持supplement/revise/rebuild，返回当前agent指引、实际视图覆盖和最近来源观测，不改文件或请求来源全扫。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000001"
        brief "命令发现、字段校验与修正提示、RPC恢复及真实CLI输出状态。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000002 d6250000-0000-4000-8000-000000000016 2f63b728-1e83-4ac8-aff3-bd766333ee5e d6360000-0000-4000-8000-000000000003 800efe39-40f9-47b8-a70b-d1819705009e d6370000-0000-4000-8000-000000000002 d6270000-0000-4000-8000-000000000002 f9fd6a5e-1dc9-4263-94bd-68869da716e9 0e67a30f-f14f-43b0-9fe7-9a7ab414c9d5 4eeb09b0-6fc6-4ef1-b5bd-6dcec624f049 aa0b2a7a-539a-423c-9775-d95d64f6dc52 18e28937-86a0-4c30-82c1-f350b72a342b 9d99fef9-ad18-475c-b541-12a01049e49c 935b3fd1-92c7-4a66-ba57-119fcc15bc9a"
        version "10"
      }
    }
    service = component "本机服务 · service/" {
      description "用户数据根共享单实例常驻回环服务，认证CLI/Web并提供RPC、视图及SSE。已接受请求在客户端离开后仍保留执行/提交结果；认证请求进度查询不重发业务。控制端点与后台档案恢复分别报告，活启动所有者不强杀或并起。身份/协议、权限、未知结果及浏览登录边界保持，原任务回执从journal与归档引用恢复。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000002"
        brief "单用户常驻RPC与分类诊断、单实例恢复、浏览会话及worktree事件流。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000003 d6250000-0000-4000-8000-000000000016 0e67a30f-f14f-43b0-9fe7-9a7ab414c9d5 4eeb09b0-6fc6-4ef1-b5bd-6dcec624f049"
        version "7"
      }
    }
    core = component "核心用例 · core/" {
      description "共享的项目身份、文本模型、上下文、技能、历史、索引、观测和同步用例，供CLI与Web使用。 共享错误转换为原生EACCES/EPERM保留系统字段和权限恢复指引，既有业务错误和未知执行结果不被替换。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000003"
        brief "共享核心及按worktree装配的用例和持久化边界。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000004 f9fd6a5e-1dc9-4263-94bd-68869da716e9"
        version "2"
      }
      runtime = component "用例编排 · runtime.ts" {
        description "解析实际工作区并装配独立档案、任务、同步和观测用例。RequestTracker记录临时阶段，在途同意图复用并限制并发/暂存；按明确目标查询原回执，重启从原journal恢复，缺证据保持unknown。档案保留紧凑提交定位，浏览只读已有投影；目录转Git保留身份/资源并使旧来源待核验。 init共用版本化建模指引；model maintain返回结构覆盖与维护工作指引；sync status附pending模型复核提示，不改变完整来源检查和proof。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000012"
          brief "解析目标，装配独立worktree资源，并将命令分派到核心用例。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000004 0e67a30f-f14f-43b0-9fe7-9a7ab414c9d5 47a9761c-8c69-4907-926f-744ddf8e6ce5"
          version "7"
        }
      }
      workspace = component "项目身份 · workspace.ts" {
        description "WorkspaceRegistry读取实际Git root/common-dir与项目UUID，拒绝目标或路径重叠冲突；未登记Git工作区返回待询问的接入指引、实际路径与影响，回退仅用于拒绝/取消。init仅建立缺失文件和首次技能库，register保留已有模型。 向上以最近.harness/project.json或.git为边界；directory不调用Git、Git字段为空，新配置带可编辑默认排除。原地有效Git转换原子更新登记并保留两个UUID；既有Git缺工具或损坏不降级，复制身份冲突仍拒绝。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000004"
          brief "定位普通目录或Git工作区，隔离身份与路径，原地启用Git保留UUID和历史。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000005 9a02944d-cbb2-46da-b77f-9c0182486781 18218b5d-a2e7-45cd-bb6c-fec8287ceea2"
          version "3"
        }
      }
      model = component "文本模型 · model.ts" {
        description "loadModel读取.harness中的LikeC4、证据与别名，检查身份/引用和元数据，并保留带evidenceId的内容异常及本地文档Git归属诊断，再形成目录/正文/C4共用的快照；不改写人工知识状态。 证据格式先校验再解析引用，避免逗号串伪报ID缺失；未声明关系类型给准确DSL修正方式。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000005"
          brief "解析LikeC4与证据/别名，校验稳定身份并生成目录、正文和结构视图。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000006"
          version "3"
        }
      }
      modelMaintenance = component "模型演进 · model-maintenance.ts" {
        description "为当前agent提供补充、修订、重建指引；检查模型拓扑、实际视图及未入图叶对象。只读当前模型/证据，保留非法诊断，最近来源状态不冒充完整核验。agent通过文件工具随实现维护知识和视图，保留同一实体身份与历史，不在后台启动模型。"
        metadata {
          harness_id "80e535ec-2e3b-4287-881a-82f92bd2cafb"
          brief "版本化建模指引、结构/视图覆盖检查与模型演进提示。"
          source "fact"
          status "verified"
          evidence "47a9761c-8c69-4907-926f-744ddf8e6ce5 935b3fd1-92c7-4a66-ba57-119fcc15bc9a ba3cfd1c-08a2-439f-a9fd-32b5dd53f4ec"
          version "1"
        }
      }
      references = component "文档Git归属 · references.ts" {
        description "批量读取Git索引和原生ignore判定，为本地document证据报告未跟踪、忽略或无法核查。诊断只读，不暂存、不改变来源扫描策略，也不要求先提交才能组织上下文。"
        metadata {
          harness_id "51285d7d-1f8e-405d-a729-1363a0940efa"
          brief "对本地项目文档证据提供批量、只读的Git归属诊断。"
          source "fact"
          status "verified"
          evidence "eabb0836-b70b-4b73-aa11-806c7f49c526"
          version "1"
        }
      }
      context = component "任务上下文 · context.ts" {
        description "TaskService默认捕获模型与技能目录，来源unknown/扫描策略null；snapshot查询读取原模型，verified保持当前完整来源核验。快捷输入从原任务解析绑定和归档哈希。--stage显式追加技能方案，旧批次packet/catalog/plan与原字节保持；正文缓存有界，淘汰后从原journal重核。逐条任务契约、60天读取活动、partial、幂等和关闭边界保持；派生批次索引仅保存定位信息。 任务路由提示新增/删除模块、入口、依赖与职责变化后的结构复核，当前agent维护模型/视图并按实际范围核验；不自动展开或改写历史。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000006"
          brief "任务建档、一次联合选择、精确查询、归档交接和技能正文读取。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000007 eacd2b8f-d6ba-4aa7-9d8a-1536b33662d9 aa0b2a7a-539a-423c-9775-d95d64f6dc52 18e28937-86a0-4c30-82c1-f350b72a342b"
          version "8"
        }
      }
      skills = component "技能文件 · skills/catalog" {
        description "scanSkills从实际根目录派生轻目录和诊断，captureSkills保留选择时文件及哈希。首次seed不覆盖用户目录，方法引用不自动加入也不执行脚本。 CatalogObserver为浏览请求共享在途扫描和已检查目录，原生通知失效、周期补偿及显式刷新仍重新检查；任务选择独立捕获当前技能字节。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000007"
          brief "按实际文件扫描技能目录、核对引用与版本，并为所选文件保留字节。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000008 d6390000-0000-4000-8000-000000000001"
          version "2"
        }
      }
      archive = component "文件历史 · archive.ts" {
        description "journal与内容寻址snapshot/blob保留原提交事实。恢复流式验证完整记录、哈希链和引用，仅驻留提交头/引用与字节定位；正文按需读取并重核原指纹。原回执查询验证对应引用，不以当前文件补历史。尾部恢复、损坏区域、单写提交与原字节边界保持，不将历史当缓存删除。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000008"
          brief "保存journal提交、幂等回执、快照和技能字节，按已提交事实恢复。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000009 d6360000-0000-4000-8000-000000000008"
          version "4"
        }
      }
      index = component "派生索引 · index.ts" {
        description "SearchIndex通过固定类型消息调用index-worker中的node:sqlite。任务/实体/批次/事件投影可重建，索引不是项目模型或历史的第二套权威。 catchUp校验连续范围并在同一事务更新受影响文档与索引游标，通用事件不重复复制完整状态payload。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000009"
          brief "在worker内维护可由归档重建的SQLite投影与检索。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000a d6390000-0000-4000-8000-000000000002"
          version "2"
        }
      }
      source = component "源码与同步 · source/freshness" {
        description "source.ts以有界原生Git批量查询按目录层判定忽略规则、按UTF-8字节分块stdin，保留argv限制、链接祖先守卫、外部filter拒绝、两遍原字节及前后状态核验；管道失败保持来源unknown。freshness.ts在目录排除前处理显式引用，同时观测声明路径和经过工作区边界检查的真实目标，目标暂缺时保留最后安全目标用于观测重建。引用变更和字节回退推进代次，不扩展来源manifest；范围核验及pending清理统一处理链接与Windows大小写等价路径。成功模型的证据异常保留，命中范围不能被声明清除，无关局部proof可保存且未解决部分仍pending；目录通知只将受影响的引用文件标pending，不额外加入目录范围；单文件核验保留同目录其它引用的待核验状态。机械核验不等于语义理解。 日常变化按路径合并读取，sourceObservation单列观测范围/指纹/时间/代次，保留上次完整来源和scanPending；缺口/策略/目录变化完整补偿，忽略输出不推进来源代次。同目标status共享在途完整检查，任务绑定与verify的两遍字节/提交前复核保持。新状态日志引用原receipt状态快照并兼容旧inline记录，不改写历史。 嵌套仓库明确报告独立来源边界，不自动遍历或排除；同步冲突回执附期望/实际字段及重新审核后新建声明的恢复指引，严格CAS与旧回执保留。 普通目录适配器复用叶条目、原字节及链接边界核对，完整成功为unversioned；ignore@7.0.14读取根和嵌套.gitignore，扫描与新路径监听复用同一规则。两遍枚举/字节检查及策略指纹保留严格代次/CAS；嵌套项目或仓库未显式排除时unknown，Git原有指纹不改写。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000a"
          brief "Git及普通目录的完整来源核验、共享忽略分类、增量观测与严格代次声明。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000b d6250000-0000-4000-8000-00000000000c e94d7f43-9e04-4d1d-872f-b8125998f02e bf342397-819c-4a86-8c9c-1b9686af9b17 b8983113-8884-4915-a339-4106142e7407 9a02944d-cbb2-46da-b77f-9c0182486781 ff040559-643c-4bfd-8584-d507e92d0bdf f11ba75e-586a-4e73-916f-a588e214dc8a"
          version "8"
        }
      }
      observation = component "只读观测 · observation.ts" {
        description "ObservationManager只读取明确绑定的已有宿主日志，保留可识别的调用、结果、检查点与覆盖缺口；不装Hooks、不扫描未知会话，不把文件变化当作读取。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000b"
          brief "读取显式绑定的Codex/Claude Code日志，将支持的调用/结果保留为有限观测。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000d"
          version "1"
        }
      }
      maintenance = component "维护 · maintenance.ts" {
        description "MigrationService显式复制原型档案并保留来源、当时ID和字节；普通legacy列表及格式检查复用所属Runtime已验证档案，以提交头定位正式任务。显式迁移和所请求旧归档继续核对原字节。GC只回收明确可再生/未提交产物，保留历史和用户技能，恢复期间不执行apply。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000c"
          brief "显式复制原型档案、只读恢复旧记录，以及保守回收确定可再生数据。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000e"
          version "3"
        }
      }
    }
    web = component "可视化工作台 · web/" {
      description "React主入口main.tsx通过api.ts访问同源服务，浏览由agent经CLI建立的任务，不提供网页新建入口或关闭标签；首屏只显示加载状态，同目标刷新合并且不取消首个请求。五类与技能逐层只展命中及祖先；父对象自身正文返回时保留正文叶子和输出路径，不重复计数。其余以省略节点进入DirectoryPage独立搜索/分页列表，返回保留相机。登录在认证及浏览器会话确认后才去码；中断保留原链接及重试，Cookie未保存单独提示，同页新登录片段重新加载认证，401保留实际原因。明显损坏的技能选择理由给疑似编码提示，可展开原文；不猜写档案。历史保持当时模型/目录/技能引用，浏览不制造上下文读取。项目切换恢复会话内上次查看的工作区/可见任务/批次；首屏50条外按记住的ID查可见历史并分页精确匹配，查询失败保留记忆，确认不可见才回退最近任务。无任务保持空状态；明确当前工作区只展示最近观测，等待解析或未知模型显示最近有效版本。首响应已覆盖的SSE不补取，历史页只提示相关更新，任务列表按相关提交刷新。 directory类型显示普通目录与目录名，详情为未使用Git；任务、五类、C4、技能及历史交互沿用。"
      metadata {
        harness_id "c6250000-0000-4000-8000-00000000000d"
        brief "跨历史分页恢复可见任务，保留模型当前状态，显示五类和技能层及隐藏计数。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-00000000000f d6250000-0000-4000-8000-000000000010 d6250000-0000-4000-8000-000000000018 d6250000-0000-4000-8000-000000000019 d6250000-0000-4000-8000-00000000001a fd73b46e-52f4-4779-9daf-314249502ea4 0e16b65c-8bb4-4dc2-be03-cc93b19fe707 b35d98f4-6a6c-47eb-b2eb-b3152bf7c34d"
        version "11"
      }
    }
    runtimeSkill = artifact "Agent入口 · agent-skills/" {
      description "运行时skill决定当前操作的技能与上下文范围，复用合适且仍在上下文的正文，缺失才读取；同模型内技能变化用同任务--stage追加，新模型/verified来源绑定另建任务。默认入口不扫描源码，严格阶段proof保留。CLI负责参数发现、任务自有缺省字段、进度与回执查询，skill不搬运确定性状态。首次接入用真实宿主询问并等待，授权/拒绝复用；当前大模型直接建模和报告覆盖。权限、历史、父交接及正文返回后一次输出卡片保持。 新增/删除模块、入口、依赖和职责迁移时，在当前授权阶段补充、修订或重组文本模型，检查重要叶对象的视图覆盖；小项目随实际实现渐进补全。"
      metadata {
        harness_id "c6250000-0000-4000-8000-00000000000e"
        brief "逐轮技能与上下文入口、原生询问及受限宿主权限恢复，保留历史和实际能力边界。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000011 7f0df0da-7a72-47aa-8953-343a7927cb24 c0bf2ca0-ae94-4381-9c25-b72abe3b2f30 d6360000-0000-4000-8000-000000000001 d6360000-0000-4000-8000-000000000002 d6360000-0000-4000-8000-000000000003 d6360000-0000-4000-8000-000000000004 d6360000-0000-4000-8000-000000000005 d6270000-0000-4000-8000-000000000001 d6270000-0000-4000-8000-000000000002 d6370000-0000-4000-8000-000000000001 d6370000-0000-4000-8000-000000000005 f0aebaaa-4e29-4f81-90e2-ce786eb7ee3d 580a91f2-72da-4c49-938c-ef31d15863f5 5c648b0f-ccb6-4f46-b367-39c74a3ce972"
        version "20"
      }
    }
    library = artifact "可编辑方法 · skills/" {
      description "随包普通方法和附件首次播种到用户库，之后以实际配置文件为准，升级不覆盖用户库。默认方法自包含，移除跨技能和库根说明引用，保留同方法实际附件；用户related候选仍兼容且不自动归档。文档产出方法在留存步骤衔接当前上下文/证据及Git归属维护，quick在需核查长期关联时退出；选择/读取不等于执行。"
      metadata {
        harness_id "c6250000-0000-4000-8000-00000000000f"
        brief "Skill Hub的文件型方法来源、相关引用和附件，不是自动执行工作流。"
