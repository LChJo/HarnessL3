specification {
  element system
  element component
  element artifact
  relationship uses
  relationship guides
  relationship verifies
}
model {
  app = system "HarnessL3" {
    description "面向现有agent的项目上下文CLI，LikeC4文本、项目证据与文件型技能仍是权威。默认snapshot不全扫源码，verified/proof严格核验。v0.58按实际模型revision共享不可变结构和布局，重复证据路径合并读取，Web按分支分组，工作区核验和历史独立。v0.57事故确认后台全态归档写放大；本机已实施按需同步租约、内存失效、SQLite当前态、操作级归档核验、显式全量审计、压缩分块事务历史和增量任务记录，以及离线迁移工具。旧格式保留兼容；本机25工作区真实迁移、默认入口切换及旧冗余副本回收核验通过，用户确认当前Windows 9小时27分13秒实测基准收尾。7a3d2f5的GitHub原生三平台构建、完整程序、Web和包验收通过；完整24h及发布仍延期，实际范围以STATUS为准。"
    metadata {
      harness_id "ad94bb95-82f8-4485-b9ac-e1064fcdfa36"
      brief "以LikeC4文本组织项目上下文与文件型技能，通过CLI交接并在Web追溯任务。"
      source "fact"
      status "verified"
      evidence "d6250000-0000-4000-8000-000000000001 d6360000-0000-4000-8000-00000000000b d6360000-0000-4000-8000-00000000000c d6360000-0000-4000-8000-00000000000d d6360000-0000-4000-8000-00000000000e d6360000-0000-4000-8000-00000000000f d6360000-0000-4000-8000-000000000011 4b7bd625-f0d0-4cab-b25c-415b29b9b6f0 580a91f2-72da-4c49-938c-ef31d15863f5 5c648b0f-ccb6-4f46-b367-39c74a3ce972 7fae5745-19e5-4a97-bc55-6512138ddf54 d0f55078-08dc-44f1-9ff7-4586436177df e1b4afcb-242d-48f2-b321-8eaa2a2ecd41"
      version "16"
    }
    cli = component "CLI入口 · cli/" {
      description "解析参数并输出单个结果封套；stderr先报告requestId及阶段，总等待预算可配置，超时/取消不撤销已接受工作。request status找回原回执，unknown不自动重发。默认snapshot与显式verified分开；资源快捷参数及可省略绑定/哈希由任务记录解析，显式字段继续严格检查。静态帮助提供真实Schema路径，中文JSON优先UTF-8文件；宿主创建进程失败与CLI内权限错误分开。 model maintain支持supplement/revise/rebuild，返回当前agent指引、实际视图覆盖和最近来源观测，不改文件或请求来源全扫。 已有共享上下文只注册，本机仓库关联不改项目文件；旧配对配置修复仍要求已登记项目UUID与原配置哈希。 task select --compact只精简客户端显示，保留当次正文和技能方案，以packetRef恢复完整累计packet；不改变原请求、默认回执或归档。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000001"
      brief "命令发现、严格输入、可恢复RPC、精简输出和24小时本机链接。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000002 d6250000-0000-4000-8000-000000000016 2f63b728-1e83-4ac8-aff3-bd766333ee5e d6360000-0000-4000-8000-000000000003 800efe39-40f9-47b8-a70b-d1819705009e d6370000-0000-4000-8000-000000000002 d6270000-0000-4000-8000-000000000002 f9fd6a5e-1dc9-4263-94bd-68869da716e9 0e67a30f-f14f-43b0-9fe7-9a7ab414c9d5 4eeb09b0-6fc6-4ef1-b5bd-6dcec624f049 aa0b2a7a-539a-423c-9775-d95d64f6dc52 18e28937-86a0-4c30-82c1-f350b72a342b 9d99fef9-ad18-475c-b541-12a01049e49c 935b3fd1-92c7-4a66-ba57-119fcc15bc9a"
      version "14"
      }
    }
    service = component "本机服务 · service/" {
      description "本机认证HTTP常驻单实例；正常停机排空 accepted requests，不强杀、不并起。新空数据根在独占服务锁内创建packed格式及v2机器registry，现有v1不隐式转换，未发布迁移拒绝启动。认证RPC使用调用端真实等待预算，不另设固定响应头期限；只读全档案审计断开可取消，业务写入仍保留原回执语义。Web鉴权、24小时链接与端口持久化保持。当前态独立临时SSE不制造业务游标。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000002"
        brief "本机单实例服务、版本化数据根初始化、RPC及Web读写隔离。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000003 d6250000-0000-4000-8000-000000000016 0e67a30f-f14f-43b0-9fe7-9a7ab414c9d5 4eeb09b0-6fc6-4ef1-b5bd-6dcec624f049"
        version "11"
      }
      webAccess = component "本机网页授权 · web-access.ts" {
        description "按用户数据根持久保存签名密钥和首选回环端口。CLI签发带目标和绝对期限的24小时链接，服务按本机地址验签。Cookie独立签名并使用原期限，浏览器已有较晚的有效授权时复用。正常重启保留地址与授权，目标篡改与跨实例根验证失败。"
        metadata {
          harness_id "244d1cd2-2717-4b31-b437-b93cf96f9369"
          brief "独立签发、重复访问、绝对到期和本机重启复用。"
          source "fact"
          status "verified"
          evidence "fa0b94b7-6a85-464d-980a-79b8a1ec8598 d6250000-0000-4000-8000-000000000003"
          version "1"
        }
      }
    }
    core = component "核心用例 · core/" {
      description "共享的项目身份、文本模型、上下文、技能、历史、索引、观测和同步用例，供CLI与Web使用。 共享错误转换为原生EACCES/EPERM保留系统字段和权限恢复指引，既有业务错误和未知执行结果不被替换。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000003"
        brief "共享核心及按worktree装配的用例和持久化边界。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000004 f9fd6a5e-1dc9-4263-94bd-68869da716e9"
        version "2"
      }
      runtime = component "用例编排 · runtime.ts" {
        description "Runtime按真实目标装配任务、当前同步态与明确日志订阅。普通snapshot/handoff不读取无关历史正文；旧格式先核对journal结构，新压缩格式按事务头及目标定位。archive audit独立检查全部历史和引用，仅只读审计接受协作取消且不伪报完整性。runtime diagnostics返回逻辑IO、资源/内存、最近延迟、模型共享及后台队列计数。闲置资源释放、共享模型缓存清理、当前态SSE与业务提交游标分开；后台观测保持全局单飞并按工作区轮转公平调度，前台请求不进入后台队列。loose兼容根上journal代次落后于checkpoint时，状态投影取已签发最高代次并保守pending。保留requestId、目标隔离、身份修复前持久pending、原回执和未知范围。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000012"
          brief "按需资源与操作级档案核验、显式全量审计及当前态投影。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000004 0e67a30f-f14f-43b0-9fe7-9a7ab414c9d5 47a9761c-8c69-4907-926f-744ddf8e6ce5 d6360000-0000-4000-8000-000000000006 3fc94f45-8e43-4204-88e3-ad6962f39a5b"
          version "14"
        }
      }
      workspace = component "项目身份 · workspace.ts" {
        description "WorkspaceRegistry核对实际根、Git common-dir/origin、项目配置及机器边界。共享projectId、旧ID兼容与工作区历史隔离不变；已有上下文只register，普通目录无需Git，Git损坏不降级。新packed格式采用机器registry schemaVersion 2，遗留格式继续v1读取，新旧格式不隐式混写；通过显式迁移保留原registry字节、真实身份和技能库。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000004"
          brief "稳定项目/工作区UUID、真实目录或Git仓库边界与本机格式版本。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000005 9a02944d-cbb2-46da-b77f-9c0182486781 18218b5d-a2e7-45cd-bb6c-fec8287ceea2 d6500000-0000-4000-8000-000000000001 9a41ca91-cf24-42ec-8d0c-a9a9af21cf73"
          version "6"
        }
      }
      model = component "文本模型 · model.ts" {
        description "loadModel读取目标worktree中LikeC4、证据和别名的实际字节，校验身份、元数据及引用；同revision跨工作区共享不可变解析结构、布局与目录索引，同版本并发合并，有界缓存随空闲资源释放。每次独立校验实际证据及Git归属，同次重复证据路径只读一次，诊断按evidenceId生成；不改变原快照或来源核验。证据格式先校验再解析引用，未声明关系类型给准确DSL修正方式。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000005"
          brief "解析LikeC4与证据/别名，校验稳定身份并生成目录、正文和结构视图。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000006 1e8f0d15-2ab8-4996-82e4-6ad105e1f040"
          version "4"
        }
      }
      modelMaintenance = component "模型演进 · model-maintenance.ts" {
        description "为当前agent提供补充、修订、重建指引；检查模型拓扑、实际视图及未入图叶对象。只读当前模型/证据，保留非法诊断，最近来源状态不冒充完整核验。agent通过文件工具随实现维护知识和视图，保留同一实体身份与历史，不在后台启动模型。"
        metadata {
          harness_id "80e535ec-2e3b-4287-881a-82f92bd2cafb"
          brief "版本化建模指引、结构/视图覆盖检查与模型演进提示。"
          source "fact"
          status "verified"
          evidence "47a9761c-8c69-4907-926f-744ddf8e6ce5 935b3fd1-92c7-4a66-ba57-119fcc15bc9a ba3cfd1c-08a2-439f-a9fd-32b5dd53f4ec"
          version "1"
        }
      }
      references = component "文档Git归属 · references.ts" {
        description "批量读取Git索引和原生ignore判定，为本地document证据报告未跟踪、忽略或无法核查。诊断只读，不暂存、不改变来源扫描策略，也不要求先提交才能组织上下文。"
        metadata {
          harness_id "51285d7d-1f8e-405d-a729-1363a0940efa"
          brief "对本地项目文档证据提供批量、只读的Git归属诊断。"
          source "fact"
          status "verified"
          evidence "eabb0836-b70b-4b73-aa11-806c7f49c526"
          version "1"
        }
      }
      context = component "任务上下文 · context.ts" {
        description "TaskService默认snapshot捕获模型与技能目录，来源unknown；verified保持完整来源核验。联合选择、精准读取、阶段追加、60天活动及原回执幂等保持。旧格式完整任务记录兼容；packed后续任务提交由task-delta记录变化字段、packet增量及新批次，按原前序提交重构，业务回执原字节由内容存储保留；delta链每32次操作落一次全量基线，读取与全量审计重构成本有界。冷入口按头定位，不先打开无关正文或派生搜索；历史列表仅metadata核验，显式请求严格核对原记录与相关引用。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000006"
          brief "绑定当前模型、精确上下文与增量任务记录，按目标重建原回执。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000007 eacd2b8f-d6ba-4aa7-9d8a-1536b33662d9 aa0b2a7a-539a-423c-9775-d95d64f6dc52 18e28937-86a0-4c30-82c1-f350b72a342b 9a41ca91-cf24-42ec-8d0c-a9a9af21cf73"
          version "15"
        }
      }
      skills = component "技能文件 · skills/catalog" {
        description "scanSkills/captureSkills从实际根捕获目录、所选文件、哈希与诊断；首次seed不覆盖用户文件，不执行方法。CatalogObserver共享在途浏览扫描，通知更新版本、显式刷新及有限缓存，空闲释放监听且最多保留有限目录。任务选择独立核对实际技能字节。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000007"
          brief "实际技能文件及独立选择；浏览目录缓存有时限和容量边界。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000008 d6390000-0000-4000-8000-000000000001"
          version "3"
        }
      }
      archive = component "文件历史 · archive.ts" {
        description "Archive按实际数据根格式选择旧journal.jsonl与snapshot/blob或packed SQLite。旧结构链核验后普通用例不复原无关正文；packed从持久事务头及索引定位。请求实际原记录、回执、模型/技能引用仍严格核验，workspaceIntegrity在非全量范围为unknown。显式archive audit验证历史链和引用，长循环让渡且只读取消不被标记为档案损坏；原旧字节不重写。新格式不创建重复任务物化文件，原回执及幂等保持。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000008"
          brief "兼容旧文件日志、事务化packed历史、请求级原字节与显式完整核验。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-000000000009 d6360000-0000-4000-8000-000000000008 d6360000-0000-4000-8000-000000000006 e477f084-e25b-4733-a542-64986ce9f392 99c891dd-28b7-4f76-83e9-4709a6f6fc31 b34c74e1-cdf9-44c7-8faa-206148cf3c0e"
          version "8"
        }
      }
      currentState = component "当前状态 · current-state.ts" {
        description "CurrentStateStore保存当前FreshnessState、完整来源/模型数据及对应业务seq，按规范指纹核对，短连接事务替换。该态不是业务历史；status不生成完整历史快照，缺失已签发绑定的库或损坏时明确错误，重启仍须重新核验。"
        metadata {
          harness_id "b57a7f90-3c57-4b12-87aa-3cebd0ff5771"
          brief "单行SQLite当前同步态，原子替换且保守恢复。"
          source "fact"
          status "verified"
          evidence "4a573c42-e1d3-4ca8-9d60-0a8b0e91a6a1 6cc01907-f72b-4c6e-86c4-1660bbabb93b"
          version "1"
        }
      }
      packedArchive = component "紧凑事务档案 · packed-archive.ts" {
        description "PackedArchiveStore以压缩原字节及内容定义分块保留快照、技能及原journal行，每个worktree的路径/提交ID独立，原始SHA256可重构。提交记录和journal_heads同一SQLite事务；索引定位目标和请求，普通新任务不重放全量历史。新数据根格式marker与registry v2阻止旧程序写入。"
        metadata {
          harness_id "ce930027-84ca-4f64-8008-7d3d72e39488"
          brief "跨工作区共享原字节的SQLite块存储、提交头与事务CAS。"
          source "fact"
          status "verified"
          evidence "1fe2d2d4-20ef-40ae-b642-e9c9c30daf41 2acb8f04-f0e6-4250-aabf-34f548b5daef 7bc4dfea-dd58-4099-8c85-91c2c3ee551d"
          version "1"
        }
      }
      taskDelta = component "任务增量 · task-delta.ts" {
        description "encodeTaskDelta/applyTaskDelta只记录改变的允许字段、packet按ID增量、追加批次及继承相同绑定/技能目录/计划，不重复保存前序累积task。写入前核对重构等于原task，读时校验原前序commit及任务身份；旧完整记录作为向后兼容基线。链深由TaskService跟踪，周期全量基线限制同步重放长度。"
        metadata {
          harness_id "6be4449f-65a7-4222-997d-bf42c205c9c4"
          brief "以前一提交及变化字段编码增量，精确重构任务或批次。"
          source "fact"
          status "verified"
          evidence "a857a5c6-bb0e-4fed-9ff2-efedb4729ff1 2acb8f04-f0e6-4250-aabf-34f548b5daef"
          version "2"
        }
      }
      storageMigration = component "离线存储迁移 · migrate-packed-storage.mjs" {
        description "工具显式dry-run或apply/resume，验证源服务停止并取得临时单写guard。apply前核对目标可用空间不低于源逻辑体量，不足拒绝开始；dry-run清单按journal/快照/技能/任务/派生索引/未知分层。流式原快照/技能、journal及源/目标指纹和引用闭包，保留原registry、机器技能文件、未知内容及未提交尾；派生索引不复制。验证任务和同步/观测记录并逐工作区报告60天窗口计数后才发布目标marker，转换中目标卷近满停止并可续传，失败不切换，工具本身不删除源。实际本机25工作区无损转换及原任务/技能/安装复核通过后，按单独授权回收旧重复物理副本并验证默认路径junction；迁移证据不在卷根持续增加。"
        metadata {
          harness_id "f9c19641-a033-4db5-83e8-c3c0b4f9f223"
          brief "独立目标无损转换、原字节/引用/身份校验后发布格式。"
          source "fact"
          status "verified"
          evidence "de36567a-6bed-40e3-bf15-acde3ca652fd 2acb8f04-f0e6-4250-aabf-34f548b5daef 45053a0a-4b0c-446a-b495-f43b34a6486c"
          version "3"
        }
      }
      index = component "派生索引 · index.ts" {
        description "SearchIndex通过固定消息调用node:sqlite worker，历史列表按需建立和追赶。普通任务入口不等待冷索引；派生投影排除旧高频freshness噪声，跳过未改变文档及FTS正文，事务游标保留真实提交范围。索引可重建，不成为项目知识或运行历史权威。"
        metadata {
          harness_id "c6250000-0000-4000-8000-000000000009"
          brief "按实际业务提交派生查询，跳过普通同步噪声和未变化索引行。"
          source "fact"
          status "verified"
          evidence "d6250000-0000-4000-8000-00000000000a d6390000-0000-4000-8000-000000000002"
          version "3"
        }
      }
      source = component "源码与同步 · source/freshness" {
        description "FreshnessManager即时保守标pending，普通后台通知、合并增量观测不创建业务快照或Journal。按需租约、分类与路径批次有界，未知覆盖/过量路径标整工作区待核验，空闲释放监听，不周期全扫。显式status执行完整双遍原字节/策略/模型检查并替换SQLite当前态；显式verify保留严格CAS、字节回退、局部scopeStatus、原失败回执。重启与覆盖缺口推进失效代次，旧proof不可复用；loose兼容根上旧写者追加更低代次journal时，restore取checkpoint已签发最高代次并保守失效（CURRENT_STATE_EPOCH_REGRESSED）。明确证据引用、链接/大小写、忽略规则、普通目录和Git隔离保留。"
        metadata {
          harness_id "c6250000-0000-4000-8000-00000000000a"
          brief "原生通知只失效当前态，按需租约和显式严格源码/模型核验。"
