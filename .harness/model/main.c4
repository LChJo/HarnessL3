        status "verified"
        evidence "d6250000-0000-4000-8000-000000000012 04fbf739-c340-4ea7-9b55-80a266ca4b00"
        version "3"
      }
    }
    projectModel = artifact "权威上下文 · .harness/" {
      description "project.json保存项目内身份与相对配置，model/中的.c4/.likec4表达对象、关系与视图，evidence.json与aliases.json保存依据和身份迁移；引用的长期项目文档与模型及相关源码共同审阅。项目任务Markdown与本机task历史分开，临时目录名不决定留存。端口、机器绝对路径、访问凭证及运行历史保存在机器数据根。 普通目录同样在项目内保存权威上下文，随项目备份；只有Git项目要求随相关源码版本管理，本机历史保持隔离。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000013"
        brief "项目内保存的LikeC4文本、配置、证据及别名，随Git版本管理或普通目录备份。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000015 e553d996-f21a-4af0-bc7c-eec02753f102 18218b5d-a2e7-45cd-bb6c-fec8287ceea2 f11ba75e-586a-4e73-916f-a588e214dc8a 116a4c91-d92b-427b-8016-2fcaca15b51d"
        version "5"
      }
    }
    quality = component "隔离验证 · tests/v1与web验证" {
      description "Node与Web验证使用临时Git和隔离数据根，覆盖既有连接、提交、技能及原型监听门禁。来源批量查询回归覆盖UTF-8字节边界、文件/忽略变化、等待及判定后的祖先链接替换和stdin故障；独立合成CLI比较启动、RSS、实际上下文/技能字节及重启交接。恢复检查覆盖阻塞时控制RPC可用/GC互斥、活锁不伪报停止、单档案恢复与引用去重、已知ID不复制无关正文及后续损坏。登录检查覆盖首次与确认请求中断、Cookie缺失、同页新链接恢复、过期原因及浏览不改任务。中文链接目录中的真实安装消费者检查构建/服务指纹、旧交接一致及差异失败；双worktree完整合成历史分别测控制就绪、首次交接总耗时、热读取和RSS，并核对journal不变。连续阶段CLI验证覆盖票据转实现、同技能逐轮正文返回、空选及原任务/留存基准不变。每轮/平台独立留证，测试存在不等于本轮已通过。 增量观测验证实际读取范围与全量条目一致、祖先链接不跟随、字节回退代次、紧凑状态兼容恢复和索引增量/重建等价；浏览门禁检查恢复任务/工作区、无任务、序号去重、历史不续期及只提示更新。只读Codux副本单独测冷热读取、索引体积和定向观察，原档案指纹保持；单样本不作为SLA。审查回归覆盖首屏之外的任务/批次恢复、搜索分页精确ID、查询失败与不可见回退，以及真实模型变更等待解析时的旧快照与unknown投影。 初始化回归覆盖可校验安装示例、嵌套仓库的显式恢复、失败封套保护和仅epoch变化的冲突回放；包验证检查帮助引用在实际安装目录可读。 目录夹具覆盖无Git CLI闭环、默认排除、多层忽略、中文/二进制、链接/嵌套边界、扫描故障、同服务Git转换和历史保留；真实npm消费者的无Git目录及浏览器检查按实际平台记录。 权限测试在自建临时目录内恢复原ACL后清理，检查CLI原requestId/退出码/封套、描述文件/锁拒绝及安装复制错误；真实受限宿主审批链另行验收。 模型维护隔离回归检查模式、无来源全扫/权威写入、非法模型恢复、未入图叶对象、新旧模型图隔离及pending指引；安装包验证Git与普通目录的新入口。"
      metadata {
        harness_id "c6250000-0000-4000-8000-000000000010"
        brief "隔离核验正式契约、逐轮技能、画布计数与增量观测，按实际平台留证。"
        source "fact"
        status "verified"
        evidence "d6250000-0000-4000-8000-000000000013 d6250000-0000-4000-8000-000000000017 deda538a-cccc-4f64-9909-86d4445ed1d0 c7e37e35-b20f-45d8-b816-8ad845bdb602 1e950683-1469-49c8-9164-d439932a7bf2 45053a0a-4b0c-446a-b495-f43b34a6486c 1adbda54-d648-4a22-a7b0-cf7f7a7ad845 f3392c10-b6b2-4bfb-aa3a-e7860e44c55a 5adba891-e681-40f9-8340-255671acdb9f d6360000-0000-4000-8000-000000000006 d6360000-0000-4000-8000-000000000007 d6360000-0000-4000-8000-000000000008 d6360000-0000-4000-8000-000000000009 d6360000-0000-4000-8000-00000000000a d6360000-0000-4000-8000-000000000010 d6360000-0000-4000-8000-000000000012 da230000-0000-4000-8000-000000000001 da230000-0000-4000-8000-000000000002 da230000-0000-4000-8000-000000000003 da230000-0000-4000-8000-000000000004 d6270000-0000-4000-8000-000000000003 bf342397-819c-4a86-8c9c-1b9686af9b17 b8983113-8884-4915-a339-4106142e7407 a46727cb-6683-4f87-9993-ad1101d94ceb d6370000-0000-4000-8000-000000000003 d6370000-0000-4000-8000-000000000004 c5cfe9cf-9cd7-47e0-9b89-7942dff8db74 16d54795-21a7-4696-9169-3a92cc0e40b5 2b9a98f4-94bc-4d27-a3e3-f7ed9b3c712f d6390000-0000-4000-8000-000000000003 d6390000-0000-4000-8000-000000000004 d6390000-0000-4000-8000-000000000005 d6390000-0000-4000-8000-000000000006 d6390000-0000-4000-8000-000000000007 a92a0672-621d-4e8e-a549-9d0a3cd8c16b 95672f7f-92d3-462c-8780-7ca4c7fb1561 9a02944d-cbb2-46da-b77f-9c0182486781 ff040559-643c-4bfd-8584-d507e92d0bdf b35d98f4-6a6c-47eb-b2eb-b3152bf7c34d 01b35a6e-055b-477a-aa86-f0bb7b163c23 9d14a485-e13b-45d1-8208-29d31a638e8c ba3cfd1c-08a2-439f-a9fd-32b5dd53f4ec"
