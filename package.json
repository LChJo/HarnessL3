    "evidence:verify": "node scripts/verify-evidence.mjs",
    "demo:agent": "node scripts/agent-example.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "@likec4/core": "1.60.0",
