{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "build", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "declaration": true, "sourceMap": false, "noEmitOnError": true
  },
  "include": ["core/**/*.ts", "cli/**/*.ts", "service/**/*.ts"],
  "exclude": ["node_modules", "build"]
}
