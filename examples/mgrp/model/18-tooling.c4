// 局部维护入口；与 01-project.c4 共享同一稳定对象身份。
model {
  extend mgrp.tooling {
    pack = component "mgrp.py" {
      description "离线构建 MGRP 资源包。"
      technology "Python / package generation"
      metadata {
        source "source-code"
        evidence "e-mgrp-tooling-pack"
        status "source-inspected"
        path "tools/mgrp_pack_scripts/mgrp.py"
        stable_id "mgrp.tooling.pack"
      }

    }
    patch = component "patch.py" {
      description "离线 patch / 解包工具。"
      technology "Python / patch tooling"
      metadata {
        source "source-code"
        evidence "e-mgrp-tooling-patch"
        status "source-inspected"
        path "tools/mgrp_pack_scripts/patch.py"
        stable_id "mgrp.tooling.patch"
      }

    }
  }
}
