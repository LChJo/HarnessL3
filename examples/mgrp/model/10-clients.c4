// 局部维护入口；与 01-project.c4 共享同一稳定对象身份。
model {
  extend mgrp.clients {
    unity = component "Unity C# 接口" {
      description "DownloadInterface 声明原生调用边界；宿主以帧更新分发回调。"
      technology "Unity / C#"
      metadata {
        source "source-code"
        evidence "e-mgrp-clients-unity"
        status "source-inspected"
        path "src/platforms/Unity3D/Downloader/Runtime/Impletion/DownloadInterface.cs"
        stable_id "mgrp.clients.unity"
      }

    }
    android = component "Android JNI" {
      description "Java 调用到内部 C ABI 的 JNI 适配。"
      technology "Android / JNI"
      metadata {
        source "source-code"
        evidence "e-mgrp-clients-android"
        status "source-inspected"
        path "src/platforms/Android/mgrp/src/main/cpp/mgrp_android_jni_adapter.cpp"
        stable_id "mgrp.clients.android"
      }

    }
    ios = component "iOS Bootstrap" {
      description "安装 iOS 平台服务和生命周期支持。"
      technology "iOS / Objective-C++"
      metadata {
        source "source-code"
        evidence "e-mgrp-clients-ios"
        status "source-inspected"
        path "src/platforms/iOS/mgrp/MGRPIOSPlatformBootstrap.mm"
        stable_id "mgrp.clients.ios"
      }

    }
    harmony = component "HarmonyOS N-API" {
      description "ArkTS 与原生 SDK 的 N-API 边界。"
      technology "HarmonyOS / N-API"
      metadata {
        source "source-code"
        evidence "e-mgrp-clients-harmony"
        status "source-inspected"
        path "src/platforms/Harmony/mgrp/src/main/cpp/mgrp_harmony_napi.cpp"
        stable_id "mgrp.clients.harmony"
      }

    }
  }
}
